---
---

<section id="features" class="py-20 bg-[#030407] relative overflow-hidden border-t border-white/10">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
        ENGINEERING & ARCHITECTURE
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-extrabold text-white font-display">
        Built for Reliability & Total Privacy
      </h2>
      <p class="mt-4 text-neutral-400 text-base sm:text-lg">
        Explore how Dosezy solves medication adherence challenges through accessible design and local-first systems engineering.
      </p>
    </div>

    <!-- Bento Grid Container -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Bento Item 1: Large Featured Card - Zero Network Privacy -->
      <div class="md:col-span-2 vercel-card p-8 rounded-3xl relative overflow-hidden flex flex-col justify-between group">
        
        <div class="absolute -top-10 -right-10 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-600/20 transition-all duration-500"></div>

        <div>
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-mono bg-sky-500/10 text-sky-300 border border-sky-500/20 mb-6">
            <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>KERNEL-ENFORCED PRIVACY</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold text-white font-display">
            Zero Network Permissions. <br />
            100% Local Data Ownership.
          </h3>
          
          <p class="mt-4 text-neutral-400 text-sm leading-relaxed max-w-xl">
            Commercial reminder apps often sell or aggregate your prescription routines. Dosezy intentionally omits <code class="text-sky-300 font-mono">android.permission.INTERNET</code> from its manifest, ensuring your medical history never leaves your device.
          </p>
        </div>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-white/10 text-xs font-mono">
          <div class="bg-black/40 p-3 rounded-xl border border-white/5">
            <span class="text-neutral-400 block text-[10px] uppercase">Storage Engine</span>
            <span class="text-sky-300 font-bold text-sm">SQLite Room DB</span>
          </div>
          <div class="bg-black/40 p-3 rounded-xl border border-white/5">
            <span class="text-neutral-400 block text-[10px] uppercase">Telemetry / Ads</span>
            <span class="text-sky-300 font-bold text-sm">0 Byte Transmitted</span>
          </div>
          <div class="bg-black/40 p-3 rounded-xl border border-white/5">
            <span class="text-neutral-400 block text-[10px] uppercase">Account Barrier</span>
            <span class="text-sky-300 font-bold text-sm">No Signup Needed</span>
          </div>
        </div>

      </div>

      <!-- Bento Item 2: Geriatric Accessibility -->
      <div id="accessibility" class="vercel-card p-8 rounded-3xl relative flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-300 text-xl mb-6">
            ♿
          </div>

          <h3 class="text-xl font-bold text-white font-display">Accessibility-First Design</h3>
          
          <p class="mt-3 text-neutral-400 text-xs leading-relaxed">
            High-contrast text palette pairing deep navy against off-white (measured 7.8:1 AAA ratio) with full support for system-wide Large Text scaling up to 200%.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-sky-300">
          <span>Large Touch Targets</span>
          <span>Presbyopia Safe</span>
        </div>
      </div>

      <!-- Bento Item 3: Alarm Scheduling Pipeline -->
      <div class="vercel-card p-8 rounded-3xl relative flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 text-xl mb-6">
            ⏰
          </div>

          <h3 class="text-xl font-bold text-white font-display">Doze-Resilient Alarm Pipeline</h3>
          
          <p class="mt-3 text-neutral-400 text-xs leading-relaxed">
            Defeats aggressive OEM battery killers (Samsung, Xiaomi, OnePlus, Pixel) using exact alarm managers, persistent wake-locks, and foreground indicators.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-sky-300">
          <span>Android 7.0 — 14</span>
          <span>Zero Dropped Alerts</span>
        </div>
      </div>

      <!-- Bento Item 4: PDF Reports & Export Hub -->
      <div class="vercel-card p-8 rounded-3xl relative flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 text-xl mb-6">
            📄
          </div>

          <h3 class="text-xl font-bold text-white font-display">Local PDF & Data Exports</h3>
          
          <p class="mt-3 text-neutral-400 text-xs leading-relaxed">
            Generate printable A4 report summaries locally for personal tracking, export JSON backup archives, or output raw CSV data anytime.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-blue-300">
          <span>On-Device Rendering</span>
          <span>Print-Ready A4</span>
        </div>
      </div>

      <!-- Bento Item 5: Emergency Services ISO Dialer -->
      <div class="vercel-card p-8 rounded-3xl relative flex flex-col justify-between group">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-xl mb-6">
            🚨
          </div>

          <h3 class="text-xl font-bold text-white font-display">Emergency ISO Dialer</h3>
          
          <p class="mt-3 text-neutral-400 text-xs leading-relaxed">
            Automatic country ISO detection from SIM/network settings. Instantly routes to official emergency dialers (US 911, EU 112, UK 999, India 112, etc.).
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-indigo-300">
          <span>Offline ISO Mapping</span>
          <span>Instant One-Tap Dial</span>
        </div>
      </div>

    </div>

  </div>
</section>
