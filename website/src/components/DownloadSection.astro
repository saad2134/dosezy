---
---

<section id="downloads" class="py-20 bg-grid-pattern relative overflow-hidden border-t border-white/10">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="px-3.5 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20 shadow-sm">
        FREE & OPEN SOURCE
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-extrabold text-white font-display">
        Get Dosezy Today
      </h2>
      <p class="mt-4 text-neutral-400 text-base sm:text-lg leading-relaxed">
        Download the 100% free offline mobile application, or optionally connect to caregiver cloud features when you need family sync.
      </p>
    </div>

    <!-- 2-Column Main Container Cards Layout -->
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- MAIN CARD 1 (COLUMN 1): Patient Client Applications -->
      <div class="vercel-card p-6 sm:p-8 rounded-3xl border border-emerald-500/30 bg-[#0a0c10]/95 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] flex flex-col justify-between h-full relative overflow-hidden group/main-client">
        <!-- Top Glow Header Flare -->
        <div class="absolute -top-16 -right-16 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl group-hover/main-client:bg-emerald-500/15 transition-all duration-500 pointer-events-none"></div>

        <div>
          <!-- Header -->
          <div class="flex flex-wrap items-center justify-between mb-6 pb-4 border-b border-white/10 text-xs font-mono font-bold uppercase tracking-wider text-neutral-400 gap-2 relative z-10">
            <span class="flex items-center space-x-2 text-white">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <span>Patient Client Applications</span>
            </span>
            <span class="text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">100% Offline Core</span>
          </div>

          <!-- Stack of Client Cards (Android & iOS) -->
          <div class="space-y-6 relative z-10">
            
            <!-- Android Client Sub-card -->
            <div class="vercel-card p-5 sm:p-6 rounded-2xl border border-emerald-500/30 bg-[#030407] hover:border-emerald-400 transition-all duration-300 flex flex-col justify-between group/android shadow-xl relative overflow-hidden hover:-translate-y-1">
              <!-- Top Right Glow Flare -->
              <div class="absolute -top-12 -right-12 w-56 h-56 bg-emerald-500/10 rounded-full blur-3xl group-hover/android:bg-emerald-500/20 transition-all duration-500 pointer-events-none"></div>

              <div class="relative z-10">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-400 shrink-0 group-hover/android:scale-105 transition-transform shadow-md">
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.5029C15.5902 8.3582 13.8535 8.01 12 8.01s-3.5902.3482-5.1366.9404L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.0858.4237 14.3385.01 18.257h23.98c-.4137-3.9185-2.6789-7.1712-6.1085-8.9356z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-white font-display group-hover/android:text-emerald-300 transition-colors">Android Client</h3>
                      <p class="text-[11px] text-neutral-400 font-mono">Kotlin & Compose • v2.2.2 APK</p>
                    </div>
                  </div>
                  <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold shadow-sm">APK</span>
                </div>

                <p class="text-xs text-neutral-300 leading-relaxed mb-4">
                  Compatible with Android 7.0 (Nougat) and higher across all major OEMs. Requires zero internet permissions and works 100% offline.
                </p>

                <!-- Download Badges -->
                <div class="flex flex-wrap items-center gap-2.5 mb-3">
                  <a href="https://f-droid.org/en/packages/com.saad2134.dosezy" target="_blank" rel="noopener noreferrer" class="inline-block hover:scale-105 transition-transform shadow-md">
                    <img src="/get-it-on-fdroid.png" alt="Get it on F-Droid" class="h-8 w-auto" />
                  </a>
                  <a href="https://github.com/saad2134/dosezy/releases" target="_blank" rel="noopener noreferrer" class="inline-block hover:scale-105 transition-transform shadow-md">
                    <img src="/get-it-on-github.png" alt="Get it on GitHub" class="h-8 w-auto" />
                  </a>
                </div>
              </div>

              <a 
                href="/patient?platform=android" 
                class="relative z-10 mt-2 pt-2.5 border-t border-white/10 text-xs font-mono text-emerald-300 font-bold flex items-center justify-between group-hover/android:text-emerald-200 transition-colors"
              >
                <span>View Patient App Details</span>
                <span class="group-hover/android:translate-x-1 transition-transform">→</span>
              </a>
            </div>

            <!-- iOS Client Sub-card -->
            <div class="vercel-card p-5 sm:p-6 rounded-2xl border border-white/20 hover:border-white/80 bg-[#030407] grayscale opacity-75 hover:grayscale-0 hover:opacity-100 transition-all duration-300 flex flex-col justify-between group/ios shadow-xl relative overflow-hidden hover:-translate-y-1">
              <!-- Top Right Glow Flare -->
              <div class="absolute -top-12 -right-12 w-56 h-56 bg-white/10 rounded-full blur-3xl group-hover/ios:bg-white/20 transition-all duration-500 pointer-events-none"></div>

              <div class="relative z-10">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-white shrink-0 group-hover/ios:scale-105 transition-transform shadow-md">
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.64-.78 1.08-1.85.96-2.92-.93.04-2.06.62-2.73 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.11-.55 2.75-1.33z"/>
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-white font-display">iOS Client</h3>
                      <p class="text-[11px] text-neutral-400 font-mono">Swift & SwiftUI</p>
                    </div>
                  </div>
                  <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-white/10 text-white border border-white/20 font-bold uppercase shadow-sm">Soon</span>
                </div>

                <p class="text-xs text-neutral-300 leading-relaxed mb-4">
                  Crafted specifically for iPhone users with UNUserNotificationCenter native alarms, Apple Secure Enclave protection, and SwiftData local storage.
                </p>

                <!-- Coming Soon Badge -->
                <div class="flex items-center justify-center h-8 bg-white/5 rounded-xl border border-white/10 px-3 mb-3 shadow-sm">
                  <span class="text-[11px] font-mono font-bold text-white/80 uppercase tracking-wider">
                    🍎 App Store & TestFlight — Coming Soon
                  </span>
                </div>
              </div>

              <a 
                href="/patient?platform=ios" 
                class="relative z-10 mt-2 pt-2.5 border-t border-white/10 text-xs font-mono text-neutral-400 group-hover/ios:text-white font-bold flex items-center justify-between transition-colors"
              >
                <span>View iOS Overview</span>
                <span class="group-hover/ios:translate-x-1 transition-transform">→</span>
              </a>
            </div>

          </div>
        </div>
      </div>

      <!-- MAIN CARD 2 (COLUMN 2): Server Node OR Caregiver Portal -->
      <div class="vercel-card p-6 sm:p-8 rounded-3xl border border-sky-500/30 bg-[#0a0c10]/95 backdrop-blur-2xl shadow-[0_25px_60px_rgba(0,0,0,0.8)] flex flex-col justify-between h-full relative overflow-hidden group/main-server">
        <!-- Top Glow Header Flare -->
        <div class="absolute -top-16 -right-16 w-72 h-72 bg-sky-500/10 rounded-full blur-3xl group-hover/main-server:bg-sky-500/15 transition-all duration-500 pointer-events-none"></div>

        <div>
          <!-- Header -->
          <div class="flex flex-wrap items-center justify-between mb-6 pb-4 border-b border-white/10 text-xs font-mono font-bold uppercase tracking-wider text-neutral-400 gap-2 relative z-10">
            <span class="flex items-center space-x-2 text-white">
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
              <span>Server Node OR Caregiver Portal</span>
            </span>
            <span class="text-sky-300 bg-sky-500/10 px-2.5 py-0.5 rounded-full border border-sky-500/20">Optional Cloud OR Self-Host</span>
          </div>

          <!-- Stack of Server Options (Dosezy Cloud & Self-Host) -->
          <div class="space-y-6 relative z-10">
            
            <!-- Caregiver Cloud Plan Card -->
            <a 
              href="/caregiver" 
              class="vercel-card p-5 sm:p-6 rounded-2xl border border-sky-500/30 bg-gradient-to-br from-sky-500/15 via-blue-600/10 to-indigo-600/15 hover:border-sky-400 transition-all duration-300 flex flex-col justify-between group/cloud shadow-xl relative overflow-hidden hover:-translate-y-1 block"
            >
              <!-- Top Right Glow Flare -->
              <div class="absolute -top-12 -right-12 w-56 h-56 bg-sky-500/10 rounded-full blur-3xl group-hover/cloud:bg-sky-500/20 transition-all duration-500 pointer-events-none"></div>

              <div class="relative z-10">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-sky-500/20 border border-sky-400/30 flex items-center justify-center text-sky-300 shrink-0 group-hover/cloud:scale-105 transition-transform shadow-md">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-white font-display group-hover/cloud:text-sky-300 transition-colors">Dosezy Cloud</h3>
                      <p class="text-[11px] text-sky-300 font-mono font-semibold">Managed Caregiver Service</p>
                    </div>
                  </div>
                  <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/30 font-bold uppercase shadow-sm">MANAGED</span>
                </div>

                <p class="text-xs text-neutral-300 leading-relaxed mb-4">
                  Managed server (<code class="text-sky-300">api.dosezy.app</code>) & Caregiver Web Portal (<code class="text-sky-300">app.dosezy.com</code>) for family tracking with real-time push/SMS alerts and zero server setup.
                </p>
              </div>

              <div class="relative z-10 pt-2.5 border-t border-white/10 text-xs font-mono text-sky-300 font-bold flex items-center justify-between group-hover/cloud:text-sky-200 transition-colors">
                <span>Explore Caregiver Cloud Portal</span>
                <span class="group-hover/cloud:translate-x-1 transition-transform">Get Started →</span>
              </div>
            </a>

            <!-- Self-Host Server Card -->
            <a 
              href="/self-host" 
              class="vercel-card p-5 sm:p-6 rounded-2xl border border-indigo-500/30 bg-[#030407] hover:border-indigo-400 transition-all duration-300 flex flex-col justify-between group/selfhost shadow-xl relative overflow-hidden hover:-translate-y-1 block"
            >
              <!-- Top Right Glow Flare -->
              <div class="absolute -top-12 -right-12 w-56 h-56 bg-indigo-500/10 rounded-full blur-3xl group-hover/selfhost:bg-indigo-500/20 transition-all duration-500 pointer-events-none"></div>

              <div class="relative z-10">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-indigo-300 shrink-0 group-hover/selfhost:scale-105 transition-transform shadow-md">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 002 2M5 12a2 2 0 01-2-2v-4a2 2 0 00-2-2" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-white font-display group-hover/selfhost:text-indigo-300 transition-colors">Self-Host Server</h3>
                      <p class="text-[11px] text-indigo-300 font-mono font-semibold">Private Docker Architecture</p>
                    </div>
                  </div>
                  <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold uppercase shadow-sm">DOCKER - FREE</span>
                </div>

                <p class="text-xs text-neutral-300 leading-relaxed mb-4">
                  Deploy your own private Dosezy Server node using Docker Compose on any home server, NAS, or VPS for 100% data sovereignty.
                </p>
              </div>

              <div class="relative z-10 pt-2.5 border-t border-white/10 text-xs font-mono text-indigo-300 font-bold flex items-center justify-between group-hover/selfhost:text-indigo-200 transition-colors">
                <span>View Self-Host Guide</span>
                <span class="group-hover/selfhost:translate-x-1 transition-transform">Deploy Docker →</span>
              </div>
            </a>

          </div>
        </div>

      </div>

    </div>

  </div>
</section>
