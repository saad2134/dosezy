---
---

<section id="research" class="py-16 bg-[#030407] border-y border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-mono font-bold tracking-widest text-sky-400 uppercase">Empirical Usability Validation</h2>
      <p class="mt-2 text-3xl font-extrabold text-white font-display">Back by Within-Subjects Clinical Research ($N=16$)</p>
      <p class="mt-3 text-neutral-400 text-sm">
        Rigorous human factors evaluation comparing Dosezy's stationary 12-Hour Grid Picker against standard Android radial clock dialogs among older adult users (ages 61–76).
      </p>
    </div>

    <!-- 4-Card Metric Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- Metric 1 -->
      <div class="vercel-card p-6 rounded-2xl relative group">
        <div class="text-4xl sm:text-5xl font-black text-cyan-400 font-display">
          -51.1<span class="text-2xl text-cyan-300">%</span>
        </div>
        <div class="mt-2 font-semibold text-white text-base">Lower Input Latency</div>
        <p class="mt-1 text-xs text-neutral-400 leading-relaxed">
          Statistically significant reduction ($p < 0.001$) in time-setting speed compared to circular radial clock pickers.
        </p>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-cyan-300">
          <span>Target: Geriatric UX</span>
          <span>$N=16$ Benchmark</span>
        </div>
      </div>

      <!-- Metric 2 -->
      <div class="vercel-card p-6 rounded-2xl relative group">
        <div class="text-4xl sm:text-5xl font-black text-sky-400 font-display">
          -89.5<span class="text-2xl text-sky-300">%</span>
        </div>
        <div class="mt-2 font-semibold text-white text-base">Fewer Touch Errors</div>
        <p class="mt-1 text-xs text-neutral-400 leading-relaxed">
          Drastic reduction in misclicks and tremor slip-offs thanks to discrete stationary button targets (min 48 × 48 dp).
        </p>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-sky-300">
          <span>AAA Contrast Ratio</span>
          <span>7.8:1 Measured</span>
        </div>
      </div>

      <!-- Metric 3 -->
      <div class="vercel-card p-6 rounded-2xl relative group">
        <div class="text-4xl sm:text-5xl font-black text-amber-400 font-display">
          0<span class="text-2xl text-amber-300"> Network Calls</span>
        </div>
        <div class="mt-2 font-semibold text-white text-base">100% Kernel Offline</div>
        <p class="mt-1 text-xs text-neutral-400 leading-relaxed">
          Manifest level omission of <code class="text-amber-300 font-mono">android.permission.INTERNET</code> ensures zero sensitive medical leak risks.
        </p>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-amber-300">
          <span>Local Room DB</span>
          <span>Zero Telemetry</span>
        </div>
      </div>

      <!-- Metric 4 -->
      <div class="vercel-card p-6 rounded-2xl relative group">
        <div class="text-4xl sm:text-5xl font-black text-blue-400 font-display">
          12<span class="text-2xl text-blue-300"> Languages</span>
        </div>
        <div class="mt-2 font-semibold text-white text-base">Native Localization</div>
        <p class="mt-1 text-xs text-neutral-400 leading-relaxed">
          Full support for English, Chinese, Spanish, Hindi, Portuguese, Arabic, French, German, Japanese, Russian, Italian, & Bengali.
        </p>
        <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-blue-300">
          <span>Auto Locale Fallback</span>
          <span>SIM ISO Dialer</span>
        </div>
      </div>

    </div>

  </div>
</section>
