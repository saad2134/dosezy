---
import TextHoverEffect from './ui/TextHoverEffect.astro';
---

<footer class="bg-[#030407] border-t border-white/10 text-neutral-400 pt-16 pb-2 text-sm relative overflow-hidden">
  <!-- Flowing Blue Line Border Effect at the Top -->
  <div class="absolute top-0 left-0 right-0 h-[1.5px] bg-white/10 overflow-hidden pointer-events-none z-10">
    <div class="w-1/2 h-full bg-gradient-to-r from-transparent via-sky-400 to-transparent shadow-[0_0_15px_#38bdf8] animate-flowing-line opacity-90"></div>
  </div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-[1px] bg-gradient-to-r from-transparent via-sky-500/40 to-transparent blur-[2px] pointer-events-none z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-6 gap-8 md:gap-10 pb-12 border-b border-white/10">
      
      <!-- Column 1: Brand Info (Wider Column Span) -->
      <div class="sm:col-span-2 md:col-span-2 space-y-4 pr-0 md:pr-6">
        <a href="/" class="flex items-center space-x-3 group">
          <img src="/icon-squircle-1000px.png" alt="Dosezy Icon" class="w-9 h-9 rounded-xl object-cover group-hover:scale-105 transition-transform" />
          <span class="font-bold text-xl text-white">Dosezy<span class="text-sky-400">.</span></span>
        </a>

        <p class="text-xs text-neutral-400 leading-relaxed max-w-md">
          An open-source, local-first medicine tracking platform engineered for accessibility, high-contrast readability, 100% data privacy, and caregiver cloud synchronization.
        </p>

        <!-- Social Icons Row (Larger & Borderless) -->
        <div class="pt-1 flex items-center space-x-2.5">
          <!-- GitHub Repository Social Icon Button -->
          <a 
            href="https://github.com/saad2134/dosezy" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.1] text-neutral-300 hover:text-white transition-all duration-300 group flex items-center justify-center"
            title="GitHub Repository"
            aria-label="GitHub Repository"
          >
            <svg class="w-5 h-5 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>

          <!-- YouTube Channel Social Icon Button -->
          <a 
            href="https://www.youtube.com/@dosezyapp" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 rounded-xl bg-white/[0.04] hover:bg-red-500/15 text-neutral-300 hover:text-red-500 transition-all duration-300 group flex items-center justify-center"
            title="YouTube Channel (@dosezyapp)"
            aria-label="YouTube Channel"
          >
            <svg class="w-5 h-5 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>

        <!-- "A Product by Saad" Creator Badge -->
        <div class="pt-1">
          <a 
            href="https://github.com/saad2134" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="relative inline-flex items-center space-x-2.5 p-2.5 rounded-xl bg-[#080a10] hover:bg-[#0c0f17] border border-white/10 hover:border-white/40 transition-all duration-300 group"
          >
            <!-- Squircle Profile Picture -->
            <div class="relative w-7 h-7 shrink-0">
              <div class="w-full h-full rounded-lg overflow-hidden border border-white/20 group-hover:border-white/60 group-hover:scale-105 transition-all">
                <img 
                  src="https://github.com/saad2134.png" 
                  alt="Saad Profile" 
                  class="w-full h-full object-cover" 
                  onerror="this.onerror=null; this.src='/icon-squircle-1000px.png';"
                />
              </div>
            </div>

            <div class="flex flex-col text-[11px] leading-tight">
              <span class="text-neutral-400 text-[9.5px] uppercase font-mono tracking-wider group-hover:text-neutral-300 transition-colors">A product of</span>
              <span class="font-bold text-white text-xs group-hover:text-white transition-colors flex items-center space-x-1">
                <span>Saad</span>
                <svg class="w-3 h-3 text-white/70 opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </span>
            </div>
          </a>
        </div>
      </div>

      <!-- Column 2: Platform -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase font-bold text-white tracking-wider">Platform</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/patient" class="hover:text-white transition-colors inline-flex items-center space-x-1.5 group">
              <span>Patient Application</span>
              <span class="inline-flex items-center space-x-1 opacity-70 group-hover:opacity-100 transition-opacity">
                <svg class="w-3.5 h-3.5 text-emerald-400 fill-current" viewBox="0 0 24 24" aria-hidden="true" title="Android">
                  <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.5029C15.5902 8.3582 13.8535 8.01 12 8.01s-3.5902.3482-5.1366.9404L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.0858.4237 14.3385.01 18.257h23.98c-.4137-3.9185-2.6789-7.1712-6.1085-8.9356z"/>
                </svg>
                <svg class="w-3.5 h-3.5 text-sky-400 fill-current" viewBox="0 0 24 24" aria-hidden="true" title="iOS">
                  <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.64-.78 1.08-1.85.96-2.92-.93.04-2.06.62-2.73 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.11-.55 2.75-1.33z"/>
                </svg>
              </span>
            </a>
          </li>
          <li>
            <a href="/server" class="hover:text-white transition-colors inline-flex items-center space-x-1.5 group">
              <span>Server Node</span>
              <svg class="w-3.5 h-3.5 text-indigo-400 fill-none opacity-70 group-hover:opacity-100 transition-opacity" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" title="Server Node">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2"/>
              </svg>
            </a>
          </li>
          <li>
            <a href="/caregiver" class="hover:text-white transition-colors inline-flex items-center space-x-1.5 group">
              <span>Caregiver Portal</span>
              <svg class="w-3.5 h-3.5 text-sky-400 fill-none opacity-70 group-hover:opacity-100 transition-opacity" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" title="Caregiver Portal Web">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
            </a>
          </li>
          <li><a href="/architecture" class="hover:text-white transition-colors">Architecture</a></li>
          <li><a href="/self-host" class="hover:text-white transition-colors font-medium">Self-Host</a></li>
          <li>
            <a href="https://github.com/saad2134/dosezy/tree/main/docs" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Docs</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="/pricing" class="font-bold text-sky-400 hover:text-sky-300 transition-colors inline-flex items-center space-x-1.5 group">
              <span>Pricing</span>
              <svg class="w-3.5 h-3.5 text-sky-400 fill-none opacity-80 group-hover:opacity-100 transition-opacity" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" title="Pricing">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
              </svg>
            </a>
          </li>
          <li><a href="/manual" class="hover:text-white transition-colors">User Manual</a></li>
          <li><a href="/faqs" class="hover:text-white transition-colors">FAQs</a></li>
        </ul>
      </div>

      <!-- Column 3: Development (With External Arrows) -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase font-bold text-white tracking-wider">Development</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="https://github.com/saad2134/dosezy" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Git Repository</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/saad2134/dosezy/issues" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Issues</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/saad2134/dosezy/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Contributing Guide</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/saad2134/dosezy/blob/main/CODE_OF_CONDUCT.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Code of Conduct</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/saad2134/dosezy/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Security Policy</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/saad2134/dosezy/blob/main/GOVERNANCE.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors inline-flex items-center space-x-1">
              <span>Governance Model</span>
              <svg class="w-3 h-3 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
          <li>
            <a href="https://github.com/sponsors/saad2134" target="_blank" rel="noopener noreferrer" class="font-bold text-rose-400 hover:text-rose-300 transition-colors inline-flex items-center space-x-1">
              <span>Sponsor & Funding</span>
              <span class="text-xs">💖</span>
              <svg class="w-3 h-3 text-rose-400/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Company -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase font-bold text-white tracking-wider">Company</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <span class="text-neutral-500 opacity-60 cursor-not-allowed inline-flex items-center space-x-1" title="Coming Soon">
              <span>About Us</span>
              <svg class="w-3 h-3 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/press" class="hover:text-white transition-colors">Press & Media Kit</a></li>
        </ul>
      </div>

      <!-- Column 5: Legal -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase font-bold text-white tracking-wider">Legal</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/cookies" class="hover:text-white transition-colors">Cookie Policy</a></li>
          <li><a href="/refund" class="hover:text-white transition-colors">Refund Policy</a></li>
          <li><a href="/disclaimer" class="hover:text-white transition-colors">Medical Disclaimer</a></li>
          <li><a href="/data-rights" class="hover:text-white transition-colors">GDPR & CCPA Rights</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright Strip -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-400 gap-4">
      <div>
        © {new Date().getFullYear() || 2026} Dosezy. All rights reserved.
      </div>
      <div class="flex items-center space-x-2">
        <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 inline-flex items-center space-x-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Operational</span>
        </span>
        <a 
          href="https://github.com/saad2134/dosezy/releases/tag/v2.2.2" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-sky-500/10 text-sky-300 border border-sky-500/20 hover:bg-sky-500/20 transition-all inline-flex items-center space-x-1"
        >
          <span>v2.2.2</span>
          <svg class="w-3 h-3 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">
          GPL-3.0*
        </span>
      </div>
    </div>

    <!-- Text Hover Effect Element (Blue Theme) -->
    <div class="h-[10rem] sm:h-[12rem] md:h-[15rem] lg:h-[18rem] xl:h-[20rem] flex items-center justify-center pt-8 pb-4">
      <TextHoverEffect text="DOSEZY" />
    </div>

  </div>
</footer>

<style>
  @keyframes flowingLine {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(200%);
    }
  }
  .animate-flowing-line {
    animation: flowingLine 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>

