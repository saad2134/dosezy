            </svg>
          </a>

          <!-- Reddit Community Social Icon Button -->
          <a 
            href="https://www.reddit.com/r/Dosezy/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="p-2 rounded-xl bg-white/[0.04] hover:bg-orange-500/15 text-neutral-300 hover:text-orange-500 transition-all duration-300 group flex items-center justify-center"
            title="Reddit Community (r/Dosezy)"
