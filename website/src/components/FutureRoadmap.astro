---
---

<section id="platform" class="py-20 bg-[#030407] relative overflow-hidden border-t border-white/10">
  
  <!-- Ambient Spotlights -->
  <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-indigo-600/10 blur-[130px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-sky-600/10 blur-[130px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
        COMPLETE ECOSYSTEM ARCHITECTURE
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-extrabold text-white font-display">
        The Dosezy Platform Suite
      </h2>
      <p class="mt-4 text-neutral-400 text-base sm:text-lg">
        A comprehensive mHealth ecosystem connecting patient clients, self-hostable sync infrastructure, and caregiver cloud platforms.
      </p>
    </div>

    <!-- Platform Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Product 1: Patient Android Client (ACTIVE NOW) -->
      <div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 text-2xl">
              💊
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-sky-500/10 text-sky-300 border border-sky-500/20">
              AVAILABLE NOW • v2.2.2
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white font-display">Patient Android Client</h3>
          <p class="text-xs font-mono text-neutral-400 mt-1">patient/android/ • Kotlin & Jetpack Compose</p>
          
          <p class="mt-4 text-neutral-400 text-sm leading-relaxed">
            Free, open-source, offline & private-by-default medicine tracking app featuring the accessible 12-Hour Grid Picker, localized emergency dialer, and zero network permissions.
          </p>

          <ul class="mt-6 space-y-2 text-xs text-neutral-300">
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>100% Offline Local Storage (SQLite Room DB)</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>12 Native Global Languages & SIM ISO Emergency Dialer</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>On-Device A4 Clinical PDF Reports & JSON Exports</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <a href="#downloads" class="px-5 py-2.5 rounded-xl bg-white text-black text-xs font-bold hover:bg-neutral-200 transition-all shadow-md">
            Download Patient APK
          </a>
          <span class="text-xs font-mono text-sky-300">F-Droid & Sideload</span>
        </div>
      </div>

      <!-- Product 2: Caregiver Cloud Platform (COMING SOON) -->
      <div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 text-2xl">
              🩺
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-sky-500/10 text-sky-300 border border-sky-500/20">
              CAREGIVER PORTAL
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white font-display">Caregiver Cloud Platform</h3>
          <p class="text-xs font-mono text-sky-400 mt-1">app.dosezy.com • caregiver/ at caregiver.dosezy.app</p>
          
          <p class="mt-4 text-neutral-400 text-sm leading-relaxed">
            Dedicated web portal for family members, elderly caregivers, and health practitioners. Monitor patient prescription compliance remotely with patient-controlled granular sharing consent.
          </p>

          <ul class="mt-6 space-y-2 text-xs text-neutral-300">
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Granular Patient Sharing Consent & Multi-Profile Dashboard</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Instant Family Push Notifications for Missed Doses</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Patient-Controlled Data Revocation & End-to-End Encryption</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <button disabled class="px-5 py-2.5 rounded-xl bg-white/10 text-neutral-400 border border-white/10 text-xs font-bold cursor-not-allowed">
            Coming Soon
          </button>
          <span class="text-xs font-mono text-sky-300">app.dosezy.com</span>
        </div>
      </div>

      <!-- Product 3: Self-Hostable Backend & Sync Engine (COMING SOON) -->
      <div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 text-2xl">
              🖥️
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-sky-500/10 text-sky-300 border border-sky-500/20">
              SELF-HOSTABLE SERVER
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white font-display">Self-Hosted Server</h3>
          <p class="text-xs font-mono text-sky-400 mt-1">server/ • PostgreSQL & Docker Node</p>
          
          <p class="mt-4 text-neutral-400 text-sm leading-relaxed">
            100% open-source sync backend for users who want multi-device synchronization without trusting third-party cloud SaaS providers.
          </p>

          <ul class="mt-6 space-y-2 text-xs text-neutral-300">
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>One-Click Docker Compose Deployment</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>CRDT Conflict-Free Offline Mutation Queue</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span>Client-Side Payload Encryption (E2EE)</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <button disabled class="px-5 py-2.5 rounded-xl bg-white/10 text-neutral-400 border border-white/10 text-xs font-bold cursor-not-allowed">
            Coming Soon
          </button>
          <span class="text-xs font-mono text-sky-300">api.dosezy.app</span>
        </div>
      </div>

      <!-- Product 4: Native iOS Patient Client (COMING SOON) -->
      <div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 text-2xl">
              📱
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-blue-500/10 text-blue-300 border border-blue-500/20">
              NATIVE iOS CLIENT
            </span>
          </div>

          <h3 class="text-2xl font-bold text-white font-display">Native iOS Patient Client</h3>
          <p class="text-xs font-mono text-sky-400 mt-1">patient/ios/ • Swift & SwiftUI</p>
          
          <p class="mt-4 text-neutral-400 text-sm leading-relaxed">
            Native iOS application built with Swift, SwiftUI, and SwiftData. Brings Dosezy's stationary grid picker and local privacy to iPhone users.
          </p>

          <ul class="mt-6 space-y-2 text-xs text-neutral-300">
            <li class="flex items-center space-x-2">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Apple UserNotifications Local Scheduling</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-blue-400 font-bold">✓</span>
              <span>SwiftData & CoreData Encryption</span>
            </li>
            <li class="flex items-center space-x-2">
              <span class="text-blue-400 font-bold">✓</span>
              <span>Seamless Android JSON Backup Compatibility</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <button disabled class="px-5 py-2.5 rounded-xl bg-white/10 text-neutral-400 border border-white/10 text-xs font-bold cursor-not-allowed">
            Coming Soon
          </button>
          <span class="text-xs font-mono text-blue-300">Swift & SwiftUI</span>
        </div>
      </div>

    </div>

  </div>
</section>
