---
import AccordionGallery from './ui/AccordionGallery';

const screenshotItems = [
  { 
    image: '/screenshots/home.png', 
    label: 'Home Screen', 
    alt: 'Dosezy Home Screen with Today Schedule and Adherence Metrics' 
  },
  { 
    image: '/screenshots/schedule.png', 
    label: 'Daily Schedule', 
    alt: 'Dosezy Schedule Screen with 12-Hour Timeline Calendar' 
  },
  { 
    image: '/screenshots/medicines.png', 
    label: 'Medicines Cabinet', 
    alt: 'Dosezy Medicines Screen with Stock & Frequency' 
  },
  { 
    image: '/screenshots/add-med.png', 
    label: 'Add Medicine', 
    alt: 'Dosezy Add Medicine Screen with 12-Hour Grid Time Picker' 
  },
  { 
    image: '/screenshots/refill.png', 
    label: 'Notification Reliability', 
    alt: 'Dosezy Notification & Exact Alarm Diagnostic Tool' 
  },
  { 
    image: '/screenshots/reliability.png', 
    label: 'Customizable Preferences', 
    alt: 'Dosezy Customizable Appearance & Tracking Preferences' 
  }
];
---

<section class="relative pt-24 pb-20 sm:pt-28 md:pt-32 md:pb-28 overflow-hidden bg-grid-pattern">
  
  <!-- Ambient Radial Glow Spotlights (80% Sky/Blue & 20% Indigo Accent) -->
  <div class="absolute top-0 left-1/4 -translate-x-1/2 w-[700px] h-[500px] bg-gradient-to-b from-blue-600/20 via-sky-500/10 to-transparent blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[500px] h-[500px] bg-sky-500/15 blur-[120px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 xl:gap-12 items-center">
      
      <!-- Left Column: Content & Downloads (6 Cols) -->
      <div class="lg:col-span-6 xl:col-span-6 text-left flex flex-col items-start">
        
        <!-- Hero Main Heading -->
        <h1 class="text-3xl sm:text-5xl lg:text-4xl xl:text-5xl font-extrabold tracking-tight text-white leading-[1.25] font-display">
          Medication Management. <br />
          <span class="bg-gradient-to-r from-sky-300 via-blue-400 to-indigo-400 bg-clip-text text-transparent pb-2 inline-block">
            Simplified, Accessible & Private.
          </span>
        </h1>

        <!-- Subtitle (Concise ecosystem summary) -->
        <p class="mt-4 sm:mt-5 text-sm sm:text-base text-neutral-400 font-normal leading-relaxed max-w-xl">
          An accessible, open-source medication management ecosystem for patients and caregivers. Dosezy pairs a 100% offline-first, private mobile app with an optional self-hostable Caregiver Cloud for family sync and remote care: featuring tremor-friendly touch targets, high-contrast visuals, and battery-resilient alarms for complex prescriptions.
        </p>

        <!-- Feature Badges Strip (Placed Above Download Section) -->
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2.5 text-xs font-medium text-neutral-300">
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Offline First & Private</span>
          </div>
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span>Accessible UI</span>
          </div>
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Advanced Schedules</span>
          </div>
          <div class="flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span>12 Languages</span>
          </div>
        </div>

        <!-- Patient Application Section: Both Android & iOS Visible Simultaneously -->
        <div class="mt-7 w-full max-w-2xl space-y-4">
          
          <!-- Android Section -->
          <div class="space-y-2.5">
            <div class="flex items-center space-x-2">
              <h3 class="text-xs sm:text-sm font-bold text-white font-display flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 fill-sky-400" viewBox="0 0 24 24"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.5029C15.5902 8.3582 13.8535 8.01 12 8.01s-3.5902.3482-5.1366.9404L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.0858.4237 14.3385.01 18.257h23.98c-.4137-3.9185-2.6789-7.1712-6.1085-8.9356z"/></svg>
                <span>Patient Application (Android)</span>
              </h3>
            </div>

            <!-- Android Download Buttons (Wrap naturally, all on 1 row when space permits) -->
            <div class="flex flex-wrap items-center justify-start gap-2 sm:gap-2.5">
              <!-- Google Play -->
              <a 
                href="https://play.google.com/store/apps/details?id=com.saad2134.dosezy" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-block hover:scale-105 transition-transform duration-200"
              >
                <img src="/get-it-on-google-play.png" alt="Get it on Google Play" class="h-9 sm:h-10 w-auto object-contain" />
              </a>

              <!-- F-Droid -->
              <a 
                href="https://f-droid.org/en/packages/com.saad2134.dosezy" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-block hover:scale-105 transition-transform duration-200"
              >
                <img src="/get-it-on-fdroid.png" alt="Get it on F-Droid" class="h-9 sm:h-10 w-auto object-contain" />
              </a>

              <!-- GitHub -->
              <a 
                href="https://github.com/saad2134/dosezy/releases" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-block hover:scale-105 transition-transform duration-200"
              >
                <img src="/get-it-on-github.png" alt="Get it on GitHub" class="h-9 sm:h-10 w-auto object-contain" />
              </a>

              <!-- More Android Stores Button (Matches Store Badges Stroke & Height) -->
              <a 
                href="/patient?platform=android" 
                class="inline-flex items-center justify-center px-3 sm:px-3.5 h-9 sm:h-10 rounded-[4px] sm:rounded-[5px] bg-black border border-[#a6a6a6] hover:border-white text-white hover:scale-105 transition-all duration-200 group shrink-0 shadow-sm"
                title="View more Android stores and downloads"
              >
                <div class="flex items-center space-x-2 sm:space-x-2.5">
                  <svg class="w-5.5 h-5.5 sm:w-6 sm:h-6 text-white shrink-0 group-hover:scale-105 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                  </svg>
                  <div class="text-left flex flex-col justify-center leading-none">
                    <span class="text-[9px] sm:text-[9.5px] uppercase tracking-wider text-[#a6a6a6] font-semibold mb-0.5">Explore</span>
                    <span class="text-[13.5px] sm:text-[14.5px] font-bold text-white tracking-tight whitespace-nowrap">More</span>
                  </div>
                  <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 text-[#a6a6a6] group-hover:text-white group-hover:translate-x-0.5 transition-all duration-200 shrink-0 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            </div>
          </div>

          <!-- iOS Section (Simultaneously Visible) -->
          <div class="pt-3 border-t border-white/5 space-y-2.5">
            <div class="flex items-center space-x-2">
              <h3 class="text-xs sm:text-sm font-bold text-white font-display flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.64-.78 1.08-1.85.96-2.92-.93.04-2.06.62-2.73 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.11-.55 2.75-1.33z"/></svg>
                <span>Patient Application (iOS)</span>
              </h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-white/10 text-neutral-400 border border-white/10">Coming Soon</span>
            </div>

            <!-- iOS Buttons Row (Grayscaled App Store Badge) -->
            <div class="flex flex-wrap items-center justify-start gap-2 sm:gap-2.5">
              <!-- Grayscaled App Store Badge (Coming Soon) -->
              <div 
                class="inline-block grayscale opacity-60 cursor-not-allowed select-none" 
                title="App Store release coming soon"
              >
                <img 
                  src="/download-on-app-store.png" 
                  alt="Download on the App Store (Coming Soon)" 
                  class="h-9 sm:h-10 w-auto object-contain" 
                />
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- Right Column: Multiple Smartphones Accordion Device Showcase (Frameless) -->
      <div class="lg:col-span-6 xl:col-span-6 relative w-full mt-6 lg:mt-0 flex items-center justify-center">
        <div class="relative w-full">
          <AccordionGallery 
            client:load
            items={screenshotItems}
            defaultIndex={0}
            expandRatio={0.48}
            trigger="hover"
            accentColor="#38bdf8"
            height={550}
            gap={8}
            tilt={6}
            parallax={0.35}
          />
        </div>
      </div>

    </div>
  </div>
</section>
