---
---

<section class="relative pt-28 pb-24 sm:pt-32 md:pt-36 md:pb-32 overflow-hidden bg-grid-pattern">
  
  <!-- Ambient Radial Glow Spotlights (80% Sky/Blue & 20% Indigo Accent) -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-b from-blue-600/25 via-sky-500/15 to-transparent blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-sky-500/10 blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Announcement Pill -->
    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-sky-500/10 text-sky-200 border border-sky-500/20 hover:border-sky-400/40 transition-all duration-300 mb-8 cursor-pointer shadow-lg">
      <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-gradient-to-r from-sky-400 to-blue-600 text-white">v2.2.2</span>
      <span>Free, Open Source, Offline & Private by Default</span>
      <svg class="w-4 h-4 text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>

    <!-- Hero Main Heading -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.1] font-display">
      Medication Management. <br />
      <span class="bg-gradient-to-r from-sky-300 via-blue-400 to-indigo-400 bg-clip-text text-transparent">
        Simplified, Accessible & Private.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-neutral-400 max-w-3xl mx-auto font-normal leading-relaxed">
      Dosezy is a free, open-source, local-first Android medication reminder app. Replaces complex clock dials with a discrete <strong class="text-neutral-200">12-Hour Grid Picker</strong>, guarantees 100% offline privacy with zero network permissions, and ensures battery-resilient alerts across all OEM devices.
    </p>

    <!-- Patient Application Dedicated Download Card with Sub-Tabs -->
    <div class="mt-10 max-w-xl mx-auto vercel-card p-6 rounded-3xl border border-white/10 bg-[#0a0c10]/95 shadow-2xl">
      <div class="flex flex-col sm:flex-row items-center justify-between pb-4 mb-4 border-b border-white/10 gap-3">
        <div class="flex items-center space-x-3">
          <img src="/icon-squircle-1000px.png" alt="Dosezy Squircle Icon" class="w-10 h-10 rounded-xl shadow-md border border-white/10" />
          <div class="text-left">
            <h3 class="text-lg font-bold text-white font-display">Patient Application</h3>
            <p class="text-[11px] font-mono text-neutral-400">v2.2.2 • Free, Open Source & Offline</p>
          </div>
        </div>

        <!-- Platform Sub Tabs (Android / iOS) -->
        <div class="flex items-center space-x-1 bg-white/5 p-1 rounded-xl border border-white/10 text-xs font-mono">
          <button id="hero-tab-android" type="button" class="hero-sub-tab active px-3 py-1 rounded-lg text-white font-bold bg-sky-500 transition-all flex items-center space-x-1.5 shadow-sm">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.5029C15.5902 8.3582 13.8535 8.01 12 8.01s-3.5902.3482-5.1366.9404L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.0858.4237 14.3385.01 18.257h23.98c-.4137-3.9185-2.6789-7.1712-6.1085-8.9356z"/></svg>
            <span>Android</span>
          </button>
          <button id="hero-tab-ios" type="button" class="hero-sub-tab px-3 py-1 rounded-lg text-neutral-400 hover:text-white transition-all flex items-center space-x-1.5">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.64-.78 1.08-1.85.96-2.92-.93.04-2.06.62-2.73 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.11-.55 2.75-1.33z"/></svg>
            <span>iOS</span>
          </button>
        </div>
      </div>

      <!-- Android Sub-Tab Panel (F-Droid FIRST, GitHub SECOND) -->
      <div id="hero-panel-android" class="space-y-4">
        <div class="flex flex-wrap items-center justify-center gap-4">
          <!-- Get it on F-Droid (FIRST) -->
          <a 
            href="https://f-droid.org/en/packages/com.saad2134.dosezy" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-block hover:scale-105 transition-transform duration-200 shadow-xl rounded-xl overflow-hidden border border-white/10"
          >
            <img src="/get-it-on-fdroid.png" alt="Get it on F-Droid" class="h-14 w-auto object-contain" />
          </a>

          <!-- Get it on GitHub (SECOND) -->
          <a 
            href="https://github.com/saad2134/dosezy/releases" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-block hover:scale-105 transition-transform duration-200 shadow-xl rounded-xl overflow-hidden border border-white/10"
          >
            <img src="/get-it-on-github.png" alt="Get it on GitHub" class="h-14 w-auto object-contain" />
          </a>
        </div>
      </div>

      <!-- iOS Sub-Tab Panel (Coming Soon) -->
      <div id="hero-panel-ios" class="hidden p-6 rounded-xl bg-[#12151c]/80 border border-white/10 text-center space-y-3">
        <h4 class="font-bold text-white text-base">iOS Application</h4>
        <div>
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-mono font-bold bg-white/10 text-neutral-400 border border-white/10">
            Coming Soon
          </span>
        </div>
      </div>
    </div>

    <!-- Trust Badges Strip (Primary Blue Accent Focus) -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-6 text-xs sm:text-sm font-medium text-neutral-300">
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>100% Offline & Private</span>
      </div>
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>F-Droid & Open Source</span>
      </div>
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Zero Network Telemetry</span>
      </div>
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>12 Global Languages</span>
      </div>
    </div>

    <!-- Hero Banner Device Showcase Frame with README App Screenshots -->
    <div class="mt-14 relative max-w-5xl mx-auto group">
      <!-- Glow Outline Behind Frame -->
      <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 via-sky-400 to-indigo-600 rounded-2xl blur-lg opacity-40 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>

      <!-- Window Container -->
      <div class="relative rounded-2xl bg-[#0a0c10] border border-white/10 overflow-hidden shadow-2xl">
        
        <!-- Window Controls Header Bar -->
        <div class="flex items-center justify-between px-4 py-3 bg-[#12151c]/90 border-b border-white/10 text-xs font-mono text-neutral-400">
          <div class="flex items-center space-x-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            <span class="ml-3 text-sky-300 font-semibold">dosezy_app_v2.2.2_patient_preview.apk</span>
          </div>
          <div class="flex items-center space-x-3 text-neutral-400">
            <span class="px-2 py-0.5 rounded bg-sky-500/10 text-sky-300 border border-sky-500/20 text-[11px]">PERMISSION_NETWORK = NONE</span>
            <span>Android 7.0+</span>
          </div>
        </div>

        <!-- Real Screenshot Gallery Grid (Downloaded from GitHub README) -->
        <div class="bg-[#0a0c10] p-4 sm:p-6">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            
            <div class="space-y-2 group/card">
              <div class="rounded-xl overflow-hidden border border-white/10 bg-[#12151c] shadow-lg group-hover/card:border-sky-500/40 transition-all">
                <img src="/screenshots/home.png" alt="Home Screen Screenshot" class="w-full h-auto object-cover" />
              </div>
              <span class="block text-xs font-mono text-neutral-400 text-center">Home Screen</span>
            </div>

            <div class="space-y-2 group/card">
              <div class="rounded-xl overflow-hidden border border-white/10 bg-[#12151c] shadow-lg group-hover/card:border-sky-500/40 transition-all">
                <img src="/screenshots/schedule.png" alt="Schedule Screen Screenshot" class="w-full h-auto object-cover" />
              </div>
              <span class="block text-xs font-mono text-neutral-400 text-center">Schedule Screen</span>
            </div>

            <div class="space-y-2 group/card">
              <div class="rounded-xl overflow-hidden border border-white/10 bg-[#12151c] shadow-lg group-hover/card:border-sky-500/40 transition-all">
                <img src="/screenshots/medicines.png" alt="Medicines Screen Screenshot" class="w-full h-auto object-cover" />
              </div>
              <span class="block text-xs font-mono text-neutral-400 text-center">Medicines Screen</span>
            </div>

            <div class="space-y-2 group/card">
              <div class="rounded-xl overflow-hidden border border-white/10 bg-[#12151c] shadow-lg group-hover/card:border-sky-500/40 transition-all">
                <img src="/screenshots/add-med.png" alt="Add Medicine Screen Screenshot" class="w-full h-auto object-cover" />
              </div>
              <span class="block text-xs font-mono text-neutral-400 text-center">Add Medicine</span>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- Client Script for Hero Sub-Tab Switching -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabAndroid = document.getElementById('hero-tab-android');
    const tabIos = document.getElementById('hero-tab-ios');
    const panelAndroid = document.getElementById('hero-panel-android');
    const panelIos = document.getElementById('hero-panel-ios');

    if (tabAndroid && tabIos && panelAndroid && panelIos) {
      tabAndroid.addEventListener('click', () => {
        tabAndroid.classList.add('bg-sky-500', 'text-white', 'font-bold', 'shadow-sm');
        tabAndroid.classList.remove('text-neutral-400');
        tabIos.classList.remove('bg-sky-500', 'text-white', 'font-bold', 'shadow-sm');
        tabIos.classList.add('text-neutral-400');

        panelAndroid.classList.remove('hidden');
        panelIos.classList.add('hidden');
      });

      tabIos.addEventListener('click', () => {
        tabIos.classList.add('bg-sky-500', 'text-white', 'font-bold', 'shadow-sm');
        tabIos.classList.remove('text-neutral-400');
        tabAndroid.classList.remove('bg-sky-500', 'text-white', 'font-bold', 'shadow-sm');
        tabAndroid.classList.add('text-neutral-400');

        panelIos.classList.remove('hidden');
        panelAndroid.classList.add('hidden');
      });
    }
  });
</script>
