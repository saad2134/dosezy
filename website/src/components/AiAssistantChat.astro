---
---

<!-- Fixed Floating AI Assistant Chat Widget (Bottom Right) -->
<div id="ai-chat-widget" class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 font-sans pointer-events-none">
  
  <!-- Chat Window Drawer (Anchored Absolutely Above Squircle Trigger) -->
  <div 
    id="ai-chat-window" 
    class="hidden pointer-events-auto absolute bottom-16 right-0 w-[calc(100vw-2.5rem)] max-w-sm sm:w-96 bg-[#0a0c10]/95 backdrop-blur-2xl border border-white/20 rounded-3xl shadow-[0_25px_60px_rgba(0,0,0,0.9)] overflow-hidden transform opacity-0 scale-95 transition-all duration-300 origin-bottom-right"
  >
    <!-- Header Bar -->
    <div class="px-4 py-3.5 bg-[#12151c]/90 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center space-x-2.5">
        <div class="relative w-8 h-8 rounded-xl bg-gradient-to-tr from-sky-500/20 to-blue-600/20 border border-white/10 p-[1px] shadow-md flex items-center justify-center shrink-0">
          <div class="w-full h-full bg-[#0a0c10] rounded-[11px] flex items-center justify-center p-1.5">
            <img src="/icons/star.png" alt="Dosezy AI" class="w-full h-full object-contain" />
          </div>
        </div>
        <div>
          <h4 class="font-bold text-white text-xs font-display">
            Dosezy AI Assistant
          </h4>
          <p class="text-[10px] text-neutral-400 font-mono">Local-First Guide & Support</p>
        </div>
      </div>

      <!-- Close Button -->
      <button 
        id="ai-chat-close-btn"
        type="button"
        class="p-1.5 rounded-lg text-neutral-400 hover:text-white hover:bg-white/10 transition-colors focus:outline-none cursor-pointer"
        aria-label="Close AI Chat Assistant"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Chat Messages Scroll Container -->
    <div id="ai-chat-messages" class="p-4 h-72 overflow-y-auto space-y-3.5 text-xs leading-relaxed bg-grid-pattern">
      <!-- Initial AI Greeting -->
      <div class="flex items-start space-x-2.5">
        <div class="w-6 h-6 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center shrink-0 mt-0.5 p-1">
          <img src="/icons/star.png" alt="Dosezy AI" class="w-full h-full object-contain" />
        </div>
        <div class="bg-[#12151c] p-3 rounded-2xl border border-white/10 text-neutral-200 space-y-1.5 max-w-[85%]">
          <p>Hello! I am <strong>Dosezy AI</strong>. How can I assist your medication management today?</p>
          <p class="text-[11px] text-neutral-400">Ask me anything about local-first privacy, grid pickers, caregiver cloud sync, or self-hosting!</p>
        </div>
      </div>

      <!-- Quick Action Suggestion Chips -->
      <div id="ai-quick-chips" class="pt-1 flex flex-wrap gap-1.5 pl-8">
        <button data-query="How does local-first offline privacy work?" class="chip-btn text-[10px] font-mono px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/10 text-sky-300 border border-white/10 hover:border-sky-500/30 transition-all text-left cursor-pointer">
          🔒 Offline Privacy
        </button>
        <button data-query="What is the 12-Hour Grid Time Picker?" class="chip-btn text-[10px] font-mono px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/10 text-sky-300 border border-white/10 hover:border-sky-500/30 transition-all text-left cursor-pointer">
          ⏰ 12-Hour Grid Picker
        </button>
        <button data-query="How does Caregiver Cloud Sync work?" class="chip-btn text-[10px] font-mono px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/10 text-sky-300 border border-white/10 hover:border-sky-500/30 transition-all text-left cursor-pointer">
          ☁️ Caregiver Cloud
        </button>
        <button data-query="How can I self-host Dosezy on Docker?" class="chip-btn text-[10px] font-mono px-2.5 py-1 rounded-full bg-white/5 hover:bg-white/10 text-sky-300 border border-white/10 hover:border-sky-500/30 transition-all text-left cursor-pointer">
          🐳 Self-Hosting
        </button>
      </div>
    </div>

    <!-- Input Form Footer -->
    <form id="ai-chat-form" class="p-2.5 bg-[#12151c]/90 border-t border-white/10 flex items-center space-x-2">
      <input 
        type="text"
        id="ai-chat-input"
        placeholder="Type a question about Dosezy..."
        required
        autocomplete="off"
        class="flex-1 px-3.5 py-2 rounded-xl bg-[#030407] border border-white/10 text-white text-xs placeholder-neutral-500 focus:outline-none focus:border-sky-500/60 transition-colors"
      />
      <button 
        type="submit"
        class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white text-xs font-bold transition-all shadow-md flex items-center justify-center shrink-0 cursor-pointer"
        aria-label="Send Message"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
        </svg>
      </button>
    </form>
  </div>

  <!-- Go to Top Button (Positioned to the left of AI Assistant) -->
  <button 
    id="scroll-to-top-btn"
    type="button"
    class="opacity-0 scale-75 translate-y-2 pointer-events-none absolute right-[3.5rem] sm:right-[3.75rem] bottom-0 w-12 h-12 rounded-2xl bg-gradient-to-b from-[#040711]/98 via-[#020409]/98 to-[#010205]/98 hover:from-[#080e1e] hover:via-[#040710] hover:to-[#020308] backdrop-blur-2xl shadow-[inset_0_1px_1px_0_rgba(56,189,248,0.2),0_8px_30px_rgba(0,0,0,0.6)] hover:shadow-[inset_0_1px_1px_0_rgba(56,189,248,0.45),0_0_25px_rgba(14,165,233,0.4)] active:scale-95 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] flex items-center justify-center cursor-pointer overflow-hidden group text-neutral-300 hover:text-white"
    aria-label="Back to top"
    title="Back to top"
  >
    <!-- Resting Border Fading Out Downwards -->
    <div class="absolute inset-0 rounded-2xl pointer-events-none border border-sky-500/25 transition-opacity duration-300 group-hover:opacity-0 [mask-image:linear-gradient(180deg,black_0%,black_20%,transparent_85%)] [-webkit-mask-image:linear-gradient(180deg,black_0%,black_20%,transparent_85%)]"></div>

    <!-- Hover Border Fading Out Downwards -->
    <div class="absolute inset-0 rounded-2xl pointer-events-none border border-sky-400/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 [mask-image:linear-gradient(180deg,black_0%,black_25%,transparent_95%)] [-webkit-mask-image:linear-gradient(180deg,black_0%,black_25%,transparent_95%)]"></div>

    <!-- Specular Topline Highlight -->
    <div class="absolute inset-0 rounded-2xl pointer-events-none border border-transparent [border-top-color:rgba(255,255,255,0.7)] [border-left-color:rgba(56,189,248,0.35)] [border-right-color:rgba(56,189,248,0.35)] opacity-0 group-hover:opacity-100 transition-opacity duration-300 [mask-image:linear-gradient(180deg,black_0%,transparent_50%)] [-webkit-mask-image:linear-gradient(180deg,black_0%,transparent_50%)]"></div>

    <!-- Ambient Blue Caustic Glow (Subtle Dark Underglow) -->
    <div class="absolute inset-0 bg-gradient-to-tr from-sky-500/10 via-blue-600/5 to-transparent opacity-40 group-hover:opacity-80 transition-opacity duration-300 pointer-events-none"></div>

    <!-- Arrow Icon -->
    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-neutral-300 group-hover:text-white transition-transform duration-200 group-hover:-translate-y-0.5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <!-- Squircle Trigger Button (Dark Obsidian Midnight Glass, Star Emblem) -->
  <button 
    id="ai-chat-trigger-btn"
    type="button"
    class="pointer-events-auto relative w-12 h-12 rounded-2xl bg-gradient-to-b from-[#040711]/98 via-[#020409]/98 to-[#010205]/98 hover:from-[#080e1e] hover:via-[#040710] hover:to-[#020308] backdrop-blur-2xl shadow-[inset_0_1px_1px_0_rgba(56,189,248,0.2),0_8px_30px_rgba(0,0,0,0.6)] hover:shadow-[inset_0_1px_1px_0_rgba(56,189,248,0.45),0_0_25px_rgba(14,165,233,0.4)] active:scale-95 transition-all duration-200 flex items-center justify-center cursor-pointer overflow-hidden group"
    aria-label="Open Dosezy AI Assistant"
  >
    <!-- Resting Border Fading Out Downwards -->
    <div class="absolute inset-0 rounded-2xl pointer-events-none border border-sky-500/25 transition-opacity duration-300 group-hover:opacity-0 [mask-image:linear-gradient(180deg,black_0%,black_20%,transparent_85%)] [-webkit-mask-image:linear-gradient(180deg,black_0%,black_20%,transparent_85%)]"></div>

    <!-- Hover Border Fading Out Downwards -->
    <div class="absolute inset-0 rounded-2xl pointer-events-none border border-sky-400/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 [mask-image:linear-gradient(180deg,black_0%,black_25%,transparent_95%)] [-webkit-mask-image:linear-gradient(180deg,black_0%,black_25%,transparent_95%)]"></div>

    <!-- Specular Topline Highlight -->
    <div class="absolute inset-0 rounded-2xl pointer-events-none border border-transparent [border-top-color:rgba(255,255,255,0.7)] [border-left-color:rgba(56,189,248,0.35)] [border-right-color:rgba(56,189,248,0.35)] opacity-0 group-hover:opacity-100 transition-opacity duration-300 [mask-image:linear-gradient(180deg,black_0%,transparent_50%)] [-webkit-mask-image:linear-gradient(180deg,black_0%,transparent_50%)]"></div>

    <!-- Ambient Blue Caustic Glow (Subtle Dark Underglow) -->
    <div class="absolute inset-0 bg-gradient-to-tr from-sky-500/10 via-blue-600/5 to-transparent opacity-40 group-hover:opacity-80 transition-opacity duration-300 pointer-events-none"></div>

    <!-- Star Icon Container with Ambient Backlight -->
    <div class="relative w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center pointer-events-none z-10 transition-transform duration-200 group-hover:scale-110 drop-shadow-[0_0_8px_rgba(56,189,248,0.3)]">
      <!-- Static Star (Default resting state) -->
      <img 
        src="/icons/star.png" 
        alt="" 
        width="24" 
        height="24" 
        class="w-full h-full object-contain select-none transition-opacity duration-200 group-hover:opacity-0" 
      />
      <!-- Animated APNG Star (Smooth 60-frame loop on hover) -->
      <img 
        src="/icons/star-a.apng" 
        alt="Dosezy AI Assistant" 
        width="24" 
        height="24" 
        class="w-full h-full object-contain select-none absolute inset-0 m-auto transition-opacity duration-200 opacity-0 group-hover:opacity-100" 
      />
    </div>
  </button>

</div>

<!-- Client Interactive Script for AI Assistant Chat Widget -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggerBtn = document.getElementById('ai-chat-trigger-btn');
    const closeBtn = document.getElementById('ai-chat-close-btn');
    const chatWindow = document.getElementById('ai-chat-window');
    const chatMessages = document.getElementById('ai-chat-messages');
    const chatForm = document.getElementById('ai-chat-form') as HTMLFormElement | null;
    const chatInput = document.getElementById('ai-chat-input') as HTMLInputElement | null;
    const chipBtns = document.querySelectorAll('.chip-btn');

    // Scroll To Top Handler (Attenomy physics easeOutCubic engine)
    const scrollToTopBtn = document.getElementById('scroll-to-top-btn');
    if (scrollToTopBtn) {
      const handleScroll = () => {
        if (window.scrollY > 350) {
          scrollToTopBtn.classList.remove('opacity-0', 'scale-75', 'translate-y-2', 'pointer-events-none');
          scrollToTopBtn.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          scrollToTopBtn.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
          scrollToTopBtn.classList.add('opacity-0', 'scale-75', 'translate-y-2', 'pointer-events-none');
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      scrollToTopBtn.addEventListener('click', () => {
        const startPosition = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
        if (startPosition === 0) return;

        // Smooth duration scaled between 600ms and 850ms based on scroll distance
        const duration = Math.min(850, Math.max(600, Math.sqrt(startPosition) * 14));
        let startTime: number | null = null;

        // Ease Out Cubic: starts with physical momentum and glides smoothly to rest
        const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

        const step = (currentTime: number) => {
          if (!startTime) startTime = currentTime;
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easedProgress = easeOutCubic(progress);

          window.scrollTo(0, Math.round(startPosition * (1 - easedProgress)));

          if (progress < 1) {
            requestAnimationFrame(step);
          }
        };

        requestAnimationFrame(step);
      });
    }

    const KNOWLEDGE_BASE: Record<string, string> = {
      privacy: "🔒 **100% Local Privacy**: Dosezy omits `android.permission.INTERNET` from its core Android manifest. Your prescription schedules and medical history stay 100% offline inside an encrypted local SQLite Room database.",
      grid: "⏰ **12-Hour Grid Time Picker**: Designed specifically for geriatric accessibility and tremor reduction! Replaces rotating radial clock dials with 12 stationary, high-contrast touch targets (48 × 48 dp min). Learn more in [/manual](/manual).",
      cloud: "☁️ **Dosezy Cloud**: An optional managed service for families. Provides caregiver web portal monitoring at [caregiver.dosezy.app](https://caregiver.dosezy.app) with real-time missed dose push alerts and patient-controlled E2EE consent.",
      selfhost: "🐳 **Self-Hosting**: You can deploy your own private sync node on Docker Compose & PostgreSQL (`server/`). See [/self-host](/self-host) for complete hardware sovereignty with zero external API calls.",
      download: "📱 **Downloading Dosezy**: Patient App (v2.5.13) is free and available via direct APK sideload or F-Droid! Check out [/patient](/patient) for download packages."
    };

    function renderMarkdown(md: string): string {
      if (!md) return '';

      // 1. Escape raw HTML tags
      let html = md
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // 2. Multi-line Code blocks (```lang ... ```)
      html = html.replace(/```([a-zA-Z0-9_-]*)\n?([\s\S]*?)```/g, (_, lang, code) => {
        return `<pre class="p-2.5 my-2 rounded-xl bg-black/60 border border-white/10 overflow-x-auto font-mono text-[11px] text-sky-300"><code>${code.trim()}</code></pre>`;
      });

      // 3. Inline code (`code`)
      html = html.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded-md bg-white/10 text-sky-300 font-mono text-[11px] border border-white/15">$1</code>');

      // 4. Bold + Italic (***text*** or ___text___)
      html = html.replace(/(\*\*\*|___)(.*?)\1/g, '<strong class="font-bold text-white"><em class="italic">$2</em></strong>');

      // 5. Bold (**text** or __text__)
      html = html.replace(/(\*\*|__)(.*?)\1/g, '<strong class="font-semibold text-white">$2</strong>');

      // 6. Italic (*text* or _text_)
      html = html.replace(/(?<!\*)\*([^*]+)\*(?!\*)|(?<!_)_([^_]+)_(?!_)/g, '<em class="italic text-neutral-300">$1$2</em>');

      // 7. Markdown Links ([text](url))
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (match, text, url) => {
        const isExternal = url.startsWith('http://') || url.startsWith('https://');
        const target = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
        return `<a href="${url}"${target} class="text-sky-400 hover:text-sky-300 underline underline-offset-2 transition-colors">${text}</a>`;
      });

      // 8. Bullet list items (- item or * item)
      html = html.replace(/^[*-]\s+(.+)$/gm, '<li class="ml-4 list-disc text-neutral-300">$1</li>');
      html = html.replace(/((?:<li class="ml-4 list-disc text-neutral-300">.*?<\/li>\n?)+)/g, (match) => {
        return `<ul class="my-1.5 space-y-1">${match.replace(/\n/g, '')}</ul>`;
      });

      // 9. Line breaks: preserve paragraphs
      html = html.replace(/\n\n+/g, '</p><p class="mt-2">');
      html = html.replace(/\n/g, '<br />');

      // 10. Clean up empty/nested paragraphs
      html = html.replace(/<p>\s*<\/p>/g, '');
      html = html.replace(/<p><ul/g, '<ul');
      html = html.replace(/<\/ul><\/p>/g, '</ul>');
      html = html.replace(/<p><pre/g, '<pre');
      html = html.replace(/<\/pre><\/p>/g, '</pre>');

      return html;
    }

    function toggleChat(show?: boolean) {
      if (!chatWindow) return;
      const willShow = show !== undefined ? show : chatWindow.classList.contains('hidden');
      if (willShow) {
        chatWindow.classList.remove('hidden');
        requestAnimationFrame(() => {
          chatWindow.classList.remove('opacity-0', 'scale-95');
          chatWindow.classList.add('opacity-100', 'scale-100');
        });
      } else {
        chatWindow.classList.remove('opacity-100', 'scale-100');
        chatWindow.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
          chatWindow.classList.add('hidden');
        }, 200);
      }
    }

    if (triggerBtn) triggerBtn.addEventListener('click', () => toggleChat());
    if (closeBtn) closeBtn.addEventListener('click', () => toggleChat(false));

    function appendUserMessage(text: string) {
      if (!chatMessages) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex justify-end';
      const escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      msgDiv.innerHTML = `
        <div class="bg-sky-600 text-white p-3 rounded-2xl max-w-[85%] text-xs shadow-md">
          ${escaped}
        </div>
      `;
      chatMessages.appendChild(msgDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function appendAiReply(replyText: string) {
      if (!chatMessages) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start space-x-2.5 animate-fade-in';
      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center shrink-0 mt-0.5 p-1">
          <img src="/icons/star.png" alt="Dosezy AI" class="w-full h-full object-contain" />
        </div>
        <div class="bg-[#12151c] p-3 rounded-2xl border border-white/10 text-neutral-200 leading-relaxed max-w-[85%] text-xs space-y-1">
          ${renderMarkdown(replyText)}
        </div>
      `;
      chatMessages.appendChild(msgDiv);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function handleQuery(query: string) {
      appendUserMessage(query);

      const q = query.toLowerCase();
      let response = "I'm glad you asked! Dosezy is an open-source, local-first medicine tracker. You can explore our [Patient Application](/patient), [Caregiver Cloud](/caregiver), [Self-Hosting](/self-host), or [Architecture Specs](/architecture) anytime from the top navigation bar.";

      if (q.includes('privac') || q.includes('offlin') || q.includes('data')) {
        response = KNOWLEDGE_BASE.privacy;
      } else if (q.includes('grid') || q.includes('time') || q.includes('picker') || q.includes('clock')) {
        response = KNOWLEDGE_BASE.grid;
      } else if (q.includes('cloud') || q.includes('caregiver') || q.includes('sync') || q.includes('alert')) {
        response = KNOWLEDGE_BASE.cloud;
      } else if (q.includes('host') || q.includes('docker') || q.includes('server')) {
        response = KNOWLEDGE_BASE.selfhost;
      } else if (q.includes('download') || q.includes('apk') || q.includes('fdroid') || q.includes('app')) {
        response = KNOWLEDGE_BASE.download;
      }

      setTimeout(() => {
        appendAiReply(response);
      }, 500);
    }

    chipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-query');
        if (query) handleQuery(query);
      });
    });

    if (chatForm && chatInput) {
      chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const text = chatInput.value.trim();
        if (!text) return;
        chatInput.value = '';
        handleQuery(text);
      });
    }
  });
</script>
