						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<h3 class="text-lg font-bold text-white">No matching user manual guides found</h3>
					<p class="text-xs text-neutral-400">Try adjusting your search terms or selecting "All Guides" under the filter options.</p>
				</div>

			</div>

		</div>
	</main>
	<Footer />
</Layout>

<style>
	@media print {
		header, footer, nav, #main-navbar, #mobile-menu, #ai-chat-widget, #ai-chat-window, .print\:hidden {
			display: none !important;
			opacity: 0 !important;
			visibility: hidden !important;
			height: 0 !important;
		}
		body, main {
			background: #ffffff !important;
			color: #000000 !important;
			padding-top: 0 !important;
		}
		.manual-section {
			display: block !important;
			visibility: visible !important;
			margin-bottom: 2rem !important;
		}
		.manual-card {
			display: block !important;
			background: #ffffff !important;
			border: 1px solid #d1d5db !important;
			color: #000000 !important;
			page-break-inside: avoid;
			box-shadow: none !important;
			margin-bottom: 1rem !important;
		}
		.manual-card h2, .manual-card h3, .manual-card strong {
			color: #000000 !important;
		}
		.manual-card p, .manual-card li, .manual-card span {
			color: #374151 !important;
		}
		.manual-card .bg-\[\#030407\] {
			background: #f9fafb !important;
			border: 1px solid #e5e7eb !important;
			color: #111827 !important;
		}
	}
</style>

<script>
	const moduleTabBtns = document.querySelectorAll('.module-tab-btn');
	const manualSections = document.querySelectorAll('.manual-section');
	const searchInput = document.getElementById('manual-search') as HTMLInputElement | null;
	const filterPills = document.querySelectorAll('.filter-pill');
	const hiddenSortInput = document.getElementById('manual-sort') as HTMLInputElement | null;
	const emptyState = document.getElementById('manual-empty-state');

	const sortDropdownContainer = document.getElementById('custom-sort-dropdown');
	const sortDropdownBtn = document.getElementById('manual-sort-btn');
	const sortDropdownMenu = document.getElementById('manual-sort-menu');
	const sortDropdownChevron = document.getElementById('manual-sort-chevron');
	const selectedSortText = document.getElementById('selected-sort-text');
	const sortOptions = document.querySelectorAll('.sort-option');

	let activeSection = 'patient';
	let activeFilter = 'all';

	const tabConfigs: Record<string, { btnClass: string; iconClass: string; titleClass: string; badgeClass: string; descClass: string }> = {
		patient: {
			btnClass: 'module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-gradient-to-r from-sky-500/20 via-sky-500/10 to-transparent border border-sky-500/40 text-white shadow-[0_0_25px_rgba(14,165,233,0.15)]',
			iconClass: 'tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-sky-500 text-white border border-sky-400 flex items-center justify-center shrink-0 shadow-lg shadow-sky-500/30 transition-all duration-300',
			titleClass: 'tab-title text-xs sm:text-sm font-bold truncate block text-white',
			badgeClass: 'tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-sky-500/20 text-sky-300 border border-sky-500/30',
			descClass: 'tab-desc text-[11px] text-sky-200/80 truncate block mt-0.5'
		},
		server: {
			btnClass: 'module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-gradient-to-r from-amber-500/20 via-amber-500/10 to-transparent border border-amber-500/40 text-white shadow-[0_0_25px_rgba(245,158,11,0.15)]',
			iconClass: 'tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-amber-500 text-white border border-amber-400 flex items-center justify-center shrink-0 shadow-lg shadow-amber-500/30 transition-all duration-300',
			titleClass: 'tab-title text-xs sm:text-sm font-bold truncate block text-white',
			badgeClass: 'tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-amber-500/20 text-amber-300 border border-amber-500/30',
			descClass: 'tab-desc text-[11px] text-amber-200/80 truncate block mt-0.5'
		},
		caregiver: {
			btnClass: 'module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-gradient-to-r from-emerald-500/20 via-emerald-500/10 to-transparent border border-emerald-500/40 text-white shadow-[0_0_25px_rgba(16,185,129,0.15)]',
			iconClass: 'tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-500 text-white border border-emerald-400 flex items-center justify-center shrink-0 shadow-lg shadow-emerald-500/30 transition-all duration-300',
			titleClass: 'tab-title text-xs sm:text-sm font-bold truncate block text-white',
			badgeClass: 'tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30',
			descClass: 'tab-desc text-[11px] text-emerald-200/80 truncate block mt-0.5'
		}
	};

	const inactiveConfig = {
		btnClass: 'module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-[#030407]/60 border border-white/10 text-neutral-400 hover:text-white hover:border-white/20 hover:bg-white/[0.04]',
		iconClass: 'tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-neutral-400 group-hover:text-white shrink-0 transition-all duration-300',
		titleClass: 'tab-title text-xs sm:text-sm font-bold truncate block text-neutral-300 group-hover:text-white',
		badgeClass: 'tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-white/5 text-neutral-400 border border-white/10',
		descClass: 'tab-desc text-[11px] text-neutral-500 truncate block mt-0.5'
	};

	const setActiveSection = (sectionName: string) => {
		activeSection = sectionName;
		
		moduleTabBtns.forEach(btn => {
			const sec = btn.getAttribute('data-section');
			const iconElem = btn.querySelector('.tab-icon-wrapper');
			const titleElem = btn.querySelector('.tab-title');
			const badgeElem = btn.querySelector('.tab-badge');
			const descElem = btn.querySelector('.tab-desc');

			if (sec === sectionName && tabConfigs[sec]) {
				const cfg = tabConfigs[sec];
				btn.className = cfg.btnClass;
				if (iconElem) iconElem.className = cfg.iconClass;
				if (titleElem) titleElem.className = cfg.titleClass;
				if (badgeElem) badgeElem.className = cfg.badgeClass;
				if (descElem) descElem.className = cfg.descClass;
			} else {
				btn.className = inactiveConfig.btnClass;
				if (iconElem) iconElem.className = inactiveConfig.iconClass;
				if (titleElem) titleElem.className = inactiveConfig.titleClass;
				if (badgeElem) badgeElem.className = inactiveConfig.badgeClass;
				if (descElem) descElem.className = inactiveConfig.descClass;
			}
		});

		manualSections.forEach(sec => {
			if (sec.id === `section-${sectionName}`) {
				sec.classList.remove('hidden');
			} else {
				sec.classList.add('hidden');
			}
		});

		filterAndSortCards();
	};

	moduleTabBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const targetSection = btn.getAttribute('data-section');
			if (targetSection) setActiveSection(targetSection);
		});
	});

	filterPills.forEach(pill => {
		pill.addEventListener('click', () => {
			const f = pill.getAttribute('data-filter') || 'all';
			activeFilter = f;

			filterPills.forEach(p => {
				if (p === pill) {
					p.className = 'filter-pill px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold transition-all bg-sky-500 text-white border border-sky-400 shadow-sm shadow-sky-500/20';
				} else {
					p.className = 'filter-pill px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold transition-all text-neutral-400 bg-[#030407]/60 border border-white/15 hover:text-white hover:border-white/30 hover:bg-white/10';
				}
			});

			filterAndSortCards();
		});
	});

	if (sortDropdownBtn && sortDropdownMenu && sortDropdownChevron) {
		const toggleSortMenu = (open?: boolean) => {
			const isExpanded = open !== undefined ? open : sortDropdownMenu.classList.contains('hidden');
			if (isExpanded) {
				sortDropdownMenu.classList.remove('hidden');
				sortDropdownChevron.classList.add('rotate-180');
				sortDropdownBtn.setAttribute('aria-expanded', 'true');
				sortDropdownBtn.classList.add('border-sky-400', 'ring-1', 'ring-sky-400/30');
			} else {
				sortDropdownMenu.classList.add('hidden');
				sortDropdownChevron.classList.remove('rotate-180');
				sortDropdownBtn.setAttribute('aria-expanded', 'false');
				sortDropdownBtn.classList.remove('border-sky-400', 'ring-1', 'ring-sky-400/30');
			}
		};

		sortDropdownBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			toggleSortMenu();
		});

		sortOptions.forEach(opt => {
			opt.addEventListener('click', (e) => {
				e.stopPropagation();
				const target = opt as HTMLButtonElement;
				const val = target.dataset.value || 'step';
				const labelText = target.querySelector('span')?.textContent || 'Step Order';

				if (hiddenSortInput) hiddenSortInput.value = val;
				if (selectedSortText) selectedSortText.textContent = labelText;

				sortOptions.forEach(o => {
					const btn = o as HTMLButtonElement;
					const checkmark = btn.querySelector('.sort-checkmark');
					if (btn === target) {
						btn.classList.add('bg-white/10', 'text-white');
						btn.classList.remove('text-neutral-300', 'hover:bg-white/5');
						if (checkmark) checkmark.classList.remove('hidden');
					} else {
						btn.classList.remove('bg-white/10', 'text-white');
						btn.classList.add('text-neutral-300', 'hover:bg-white/5');
						if (checkmark) checkmark.classList.add('hidden');
					}
				});

				toggleSortMenu(false);
				filterAndSortCards();
			});
		});

		document.addEventListener('click', (e) => {
			if (sortDropdownContainer && !sortDropdownContainer.contains(e.target as Node)) {
				toggleSortMenu(false);
			}
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				toggleSortMenu(false);
			}
		});
	}

	const filterAndSortCards = () => {
		const query = searchInput?.value.toLowerCase().trim() || '';
		const currentSectionElem = document.getElementById(`section-${activeSection}`);
		if (!currentSectionElem) return;

		const cardsArray = Array.from(currentSectionElem.querySelectorAll('.manual-card')) as HTMLElement[];
		let visibleCount = 0;

		cardsArray.forEach(card => {
			const cardFilter = card.getAttribute('data-filter') || 'all';
			const keywords = (card.getAttribute('data-keywords') || '').toLowerCase();
			const text = card.textContent?.toLowerCase() || '';

			const matchesFilter = activeFilter === 'all' || cardFilter === activeFilter;
			const matchesQuery = query === '' || keywords.includes(query) || text.includes(query);

			if (matchesFilter && matchesQuery) {
				card.style.display = 'block';
				visibleCount++;
			} else {
				card.style.display = 'none';
			}
		});

		if (emptyState) {
			if (visibleCount === 0) {
				emptyState.classList.remove('hidden');
			} else {
				emptyState.classList.add('hidden');
			}
		}

		const sortVal = hiddenSortInput?.value || 'step';

		cardsArray.sort((a, b) => {
			if (sortVal === 'difficulty') {
				return parseInt(a.getAttribute('data-difficulty') || '0', 10) - parseInt(b.getAttribute('data-difficulty') || '0', 10);
			} else if (sortVal === 'readtime') {
				return parseInt(a.getAttribute('data-readtime') || '0', 10) - parseInt(b.getAttribute('data-readtime') || '0', 10);
			} else if (sortVal === 'title') {
				const titleA = a.querySelector('h2')?.textContent || '';
				const titleB = b.querySelector('h2')?.textContent || '';
				return titleA.localeCompare(titleB);
			} else {
				return parseInt(a.getAttribute('data-step') || '0', 10) - parseInt(b.getAttribute('data-step') || '0', 10);
			}
		});

		cardsArray.forEach(card => currentSectionElem.appendChild(card));
	};

	if (searchInput) searchInput.addEventListener('input', filterAndSortCards);
</script>
