---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="User Manual ✦ Friendly Step-by-Step Guide | Dosezy">
	<Header />
	<main class="flex-grow pt-28 sm:pt-32 pb-16 bg-[#030407] bg-grid-pattern relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<!-- Hero Header -->
			<div class="text-center max-w-3xl mx-auto mb-12">
				<div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 text-sky-300 border border-sky-500/20 text-xs font-mono font-bold mb-4">
					<svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
					</svg>
					<span>DOSEZY USER MANUAL (v2.3.1)</span>
				</div>
				
				<h1 class="text-4xl sm:text-6xl font-extrabold text-white font-display tracking-tight">
					Dosezy User Manual
				</h1>
				<p class="mt-4 text-neutral-300 text-base sm:text-lg leading-relaxed">
					Simple, step-by-step instructions to help you track daily medications, manage pill inventory, view adherence analytics, and keep your family healthy.
				</p>

				<!-- Developer Docs Redirect Banner -->
				<div class="mt-4 p-3 rounded-2xl bg-sky-500/10 border border-sky-500/20 text-xs text-sky-200 inline-flex items-center space-x-2 print:hidden">
					<svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<span>Looking for technical schemas and OpenAPI specs? Visit our <a href="https://github.com/saad2134/dosezy/tree/main/docs" target="_blank" rel="noopener noreferrer" class="text-white font-bold underline hover:text-sky-300 transition-colors inline-flex items-center space-x-1"><span>Technical Documentation Portal →</span></a></span>
				</div>

			</div>

			<!-- Three Section Module Switcher Tabs & Print Action Row -->
			<div class="max-w-6xl mx-auto mb-8 print:hidden flex flex-row items-stretch gap-3">
				
				<!-- 3 Tabs Glass Card Container -->
				<div class="p-2 sm:p-2.5 rounded-3xl bg-[#0a0c10]/95 backdrop-blur-2xl border border-white/15 grid grid-cols-1 sm:grid-cols-3 gap-2.5 shadow-[0_20px_50px_rgba(0,0,0,0.6)] flex-1 min-w-0">
					
					<!-- Patient App Tab -->
					<button 
						type="button"
						data-section="patient"
						class="module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-gradient-to-r from-sky-500/20 via-sky-500/10 to-transparent border border-sky-500/40 text-white shadow-[0_0_25px_rgba(14,165,233,0.15)]"
					>
						<div class="tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-sky-500 text-white border border-sky-400 flex items-center justify-center shrink-0 shadow-lg shadow-sky-500/30 transition-all duration-300">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
							</svg>
						</div>
						<div class="flex-1 min-w-0">
							<div class="flex items-center justify-between">
								<span class="tab-title text-xs sm:text-sm font-bold truncate block text-white">Patient App</span>
								<span class="tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-sky-500/20 text-sky-300 border border-sky-500/30">13 Guides</span>
							</div>
							<span class="tab-desc text-[11px] text-sky-200/80 truncate block mt-0.5">Offline mobile medication app</span>
						</div>
					</button>

					<!-- Server Node Tab -->
					<button 
						type="button"
						data-section="server"
						class="module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-[#030407]/60 border border-white/10 text-neutral-400 hover:text-white hover:border-white/20 hover:bg-white/[0.04]"
					>
						<div class="tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-neutral-400 group-hover:text-white shrink-0 transition-all duration-300">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
							</svg>
						</div>
						<div class="flex-1 min-w-0">
							<div class="flex items-center justify-between">
								<span class="tab-title text-xs sm:text-sm font-bold truncate block text-neutral-300 group-hover:text-white">Server Node</span>
								<span class="tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-amber-500/10 text-amber-300 border border-amber-500/20">Roadmap v3.x</span>
							</div>
							<span class="tab-desc text-[11px] text-neutral-500 truncate block mt-0.5">Optional self-hosted sync</span>
						</div>
					</button>

					<!-- Caregiver Portal Tab -->
					<button 
						type="button"
						data-section="caregiver"
						class="module-tab-btn relative group overflow-hidden py-3 px-3.5 sm:px-4 rounded-2xl text-left transition-all duration-300 flex items-center space-x-3 bg-[#030407]/60 border border-white/10 text-neutral-400 hover:text-white hover:border-white/20 hover:bg-white/[0.04]"
					>
						<div class="tab-icon-wrapper w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-neutral-400 group-hover:text-white shrink-0 transition-all duration-300">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
							</svg>
						</div>
						<div class="flex-1 min-w-0">
							<div class="flex items-center justify-between">
								<span class="tab-title text-xs sm:text-sm font-bold truncate block text-neutral-300 group-hover:text-white">Caregiver Portal</span>
								<span class="tab-badge hidden lg:inline-block px-2 py-0.5 rounded-full text-[9px] font-mono font-bold tracking-wider uppercase bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Roadmap v3.x</span>
							</div>
							<span class="tab-desc text-[11px] text-neutral-500 truncate block mt-0.5">Family web monitoring</span>
						</div>
					</button>

				</div>

				<!-- Printer Icon Button -->
				<button 
					onclick="window.print()" 
					class="w-14 sm:w-16 rounded-3xl bg-[#0a0c10]/95 hover:bg-white/[0.08] backdrop-blur-2xl border border-white/15 hover:border-white/30 transition-all flex items-center justify-center shrink-0 group shadow-[0_20px_50px_rgba(0,0,0,0.6)] cursor-pointer"
					title="Print or Save User Manual as PDF"
					aria-label="Print or Save User Manual as PDF"
				>
					<svg class="w-5 h-5 text-sky-400 group-hover:scale-110 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
					</svg>
				</button>

			</div>

			<!-- Search Bar & Filters Control Box -->
			<div class="max-w-6xl mx-auto mb-10 space-y-4 print:hidden">
				<div class="relative">
					<input 
						type="text" 
						id="manual-search" 
						placeholder="Search user manual (e.g., adding pills, presets, stock refill, analytics, grouped alarms, status colors)..." 
						class="w-full px-5 py-4 rounded-2xl bg-[#0a0c10]/95 border border-white/15 text-white text-xs sm:text-sm placeholder-neutral-500 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all shadow-xl"
					/>
					<svg class="w-5 h-5 text-neutral-500 absolute right-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
				</div>

				<div class="flex flex-col md:flex-row items-stretch gap-3">
					<div class="p-3 sm:p-3.5 rounded-2xl bg-[#0a0c10]/95 backdrop-blur-xl border border-white/15 shadow-xl flex items-center space-x-3 flex-wrap gap-y-2 flex-1 min-w-0">
						<div class="flex items-center space-x-1.5 text-sky-400 pl-1 shrink-0">
							<svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
							</svg>
							<span class="text-[10px] font-mono text-neutral-400 uppercase font-bold hidden sm:inline">Filter:</span>
						</div>
						
						<div class="flex items-center space-x-1.5 flex-wrap gap-y-1.5" id="filter-pills-container">
							<button type="button" data-filter="all" class="filter-pill px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold transition-all bg-sky-500 text-white border border-sky-400 shadow-sm shadow-sky-500/20">All Guides</button>
							<button type="button" data-filter="basics" class="filter-pill px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold transition-all text-neutral-400 bg-[#030407]/60 border border-white/15 hover:text-white hover:border-white/30 hover:bg-white/10">Quick Start</button>
							<button type="button" data-filter="config" class="filter-pill px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold transition-all text-neutral-400 bg-[#030407]/60 border border-white/15 hover:text-white hover:border-white/30 hover:bg-white/10">Settings & Stock</button>
							<button type="button" data-filter="family" class="filter-pill px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold transition-all text-neutral-400 bg-[#030407]/60 border border-white/15 hover:text-white hover:border-white/30 hover:bg-white/10">Family & Analytics</button>
						</div>
					</div>

					<div class="p-2 sm:p-2.5 rounded-2xl bg-[#0a0c10]/95 backdrop-blur-xl border border-white/15 shadow-xl flex items-center shrink-0 self-stretch md:self-auto">
						<div class="relative w-full md:w-auto" id="custom-sort-dropdown">
							<input type="hidden" id="manual-sort" value="step" />

							<button 
								type="button" 
								id="manual-sort-btn"
								aria-expanded="false"
								aria-haspopup="listbox"
								class="w-full md:w-auto px-4 py-2 rounded-xl bg-[#030407] border border-white/15 text-white text-xs font-mono flex items-center justify-between space-x-2.5 text-left focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all hover:bg-white/[0.04]"
							>
								<div class="flex items-center space-x-2">
									<svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
									</svg>
									<span class="text-[10px] text-neutral-400 uppercase font-bold">Sort:</span>
									<span id="selected-sort-text" class="text-sky-300 font-bold truncate max-w-[140px]">Step Order</span>
								</div>
								<svg id="manual-sort-chevron" class="w-3.5 h-3.5 text-neutral-400 transition-transform duration-200 shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</button>

							<div 
								id="manual-sort-menu" 
								class="hidden absolute right-0 top-full mt-1.5 z-50 w-52 p-1.5 rounded-xl bg-[#0a0c10]/98 backdrop-blur-xl border border-white/15 shadow-2xl space-y-1"
								role="listbox"
							>
								<button type="button" data-value="step" class="sort-option w-full px-3 py-2 rounded-lg text-xs font-mono flex items-center justify-between transition-colors bg-white/10 text-white font-medium">
									<span>Step Order</span>
									<svg class="sort-checkmark w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
								</button>
								<button type="button" data-value="difficulty" class="sort-option w-full px-3 py-2 rounded-lg text-xs font-mono flex items-center justify-between transition-colors text-neutral-300 hover:bg-white/5 hover:text-white font-medium">
									<span>Difficulty Level</span>
									<svg class="sort-checkmark w-3.5 h-3.5 text-sky-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
								</button>
								<button type="button" data-value="title" class="sort-option w-full px-3 py-2 rounded-lg text-xs font-mono flex items-center justify-between transition-colors text-neutral-300 hover:bg-white/5 hover:text-white font-medium">
									<span>Alphabetical (A-Z)</span>
									<svg class="sort-checkmark w-3.5 h-3.5 text-sky-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Manual Content Sections Container -->
			<div class="max-w-6xl mx-auto">
				
				<!-- ==================== TAB 1: PATIENT APP ==================== -->
				<div id="section-patient" class="manual-section space-y-6">
					
					<!-- Card 1: Getting Started & Languages -->
					<article 
						data-section="patient"
						data-step="1"
						data-filter="basics"
						data-difficulty="1"
						data-readtime="1"
						data-keywords="overview languages preferences theme getting started offline"
						class="manual-card vercel-card p-6 sm:p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 space-y-4"
					>
						<div class="flex items-center justify-between border-b border-white/10 pb-4">
							<div class="flex items-center space-x-3">
								<span class="w-8 h-8 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 font-bold text-xs">1</span>
								<h2 class="text-xl font-bold text-white font-display">Getting Started, 12 Languages & Themes</h2>
							</div>
							<div class="flex items-center space-x-2">
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Easy</span>
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono text-neutral-400 bg-white/5">1 min read</span>
							</div>
						</div>

						<p class="text-xs text-neutral-300 leading-relaxed">
							Dosezy is designed to be friendly, high-contrast, and easy to read. It operates completely offline without requiring any user registration or internet connection.
						</p>

						<div class="bg-[#030407] p-4 rounded-2xl border border-white/10 text-xs text-neutral-300 space-y-3">
							<h4 class="font-bold text-white uppercase font-mono text-[10px] tracking-wider text-sky-400">Supported Languages:</h4>
							<p class="text-[11px]">English, Spanish, Hindi, Chinese, Portuguese, Arabic, French, German, Japanese, Russian, Italian, and Bengali.</p>
							
							<h4 class="font-bold text-white uppercase font-mono text-[10px] tracking-wider text-sky-400 pt-1">How to Change Language or Theme:</h4>
							<ol class="list-decimal list-inside space-y-1.5 text-neutral-300">
								<li>Tap the <strong class="text-white">Menu</strong> tab at the bottom right.</li>
								<li>Tap <strong class="text-white">Preferences</strong>.</li>
								<li>Choose your preferred <strong class="text-white">Language</strong>, toggle between Light and Dark mode, or switch to 24-Hour time format.</li>
							</ol>
						</div>
					</article>

					<!-- Card 2: Home Screen Status Colors -->
					<article 
						data-section="patient"
						data-step="2"
						data-filter="basics"
						data-difficulty="1"
						data-readtime="1"
						data-keywords="home dashboard status colors taken late missed schedule badges"
						class="manual-card vercel-card p-6 sm:p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 space-y-4"
					>
						<div class="flex items-center justify-between border-b border-white/10 pb-4">
							<div class="flex items-center space-x-3">
								<span class="w-8 h-8 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 font-bold text-xs">2</span>
								<h2 class="text-xl font-bold text-white font-display">Home Screen, Time Headers & Dose Badges</h2>
							</div>
							<div class="flex items-center space-x-2">
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Easy</span>
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono text-neutral-400 bg-white/5">1 min read</span>
							</div>
						</div>

						<p class="text-xs text-neutral-300 leading-relaxed">
							Your Home screen lists your daily doses grouped by time. Helpful real-time indicators and colored dots show your compliance at a glance:
						</p>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
							<div class="bg-[#030407] p-3 rounded-xl border border-white/10 flex items-center space-x-3">
								<span class="w-3.5 h-3.5 rounded-full bg-emerald-400 shrink-0"></span>
								<div>
									<strong class="text-white block">Green (Taken)</strong>
									<span class="text-neutral-400 text-[11px]">Dose logged with exact completion time</span>
								</div>
							</div>
							<div class="bg-[#030407] p-3 rounded-xl border border-white/10 flex items-center space-x-3">
								<span class="w-3.5 h-3.5 rounded-full bg-neutral-400 shrink-0"></span>
								<div>
									<strong class="text-white block">Standard Text</strong>
									<span class="text-neutral-400 text-[11px]">Due soon or within your late window</span>
								</div>
							</div>
							<div class="bg-[#030407] p-3 rounded-xl border border-white/10 flex items-center space-x-3">
								<span class="w-3.5 h-3.5 rounded-full bg-amber-400 shrink-0"></span>
								<div>
									<strong class="text-white block">Orange (Late)</strong>
									<span class="text-neutral-400 text-[11px]">Past due (shows orange Mark Late button)</span>
								</div>
							</div>
							<div class="bg-[#030407] p-3 rounded-xl border border-white/10 flex items-center space-x-3">
								<span class="w-3.5 h-3.5 rounded-full bg-rose-500 shrink-0"></span>
								<div>
									<strong class="text-white block">Red (Missed)</strong>
									<span class="text-neutral-400 text-[11px]">Over 6 hours past due</span>
								</div>
							</div>
						</div>
					</article>

					<!-- Card 3: Adding Medication & Presets -->
					<article 
						data-section="patient"
						data-step="3"
						data-filter="basics"
						data-difficulty="1"
						data-readtime="1"
						data-keywords="adding medication time picker daily presets frequency dosage food instructions photos"
						class="manual-card vercel-card p-6 sm:p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 space-y-4"
					>
						<div class="flex items-center justify-between border-b border-white/10 pb-4">
							<div class="flex items-center space-x-3">
								<span class="w-8 h-8 rounded-xl bg-sky-500/10 border border-sky-500/30 flex items-center justify-center text-sky-400 font-bold text-xs">3</span>
								<h2 class="text-xl font-bold text-white font-display">Adding Medicines: Photos, Food Instructions & Presets</h2>
							</div>
							<div class="flex items-center space-x-2">
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Easy</span>
								<span class="px-2.5 py-0.5 rounded text-[10px] font-mono text-neutral-400 bg-white/5">1 min read</span>
							</div>
						</div>

						<div class="space-y-3 text-xs text-neutral-300">
							<ol class="list-decimal list-inside space-y-2 text-neutral-300">
								<li>Tap <strong class="text-white">Medicines</strong> in the bottom bar, then tap <strong class="text-white">"+ Add Medicine"</strong>.</li>
								<li>Enter the medicine name and dose unit (tablet, capsule, mg, mL, drops, puffs, units).</li>
								<li>(Optional) Tap the camera icon to take or crop a pill box photo.</li>
