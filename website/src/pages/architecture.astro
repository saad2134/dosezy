---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="System Architecture & 2D Data Flow ✦ Dosezy Monorepo">
	<Header />
	<main class="flex-grow pt-28 sm:pt-32 pb-16 bg-[#030407] bg-grid-pattern">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<!-- Hero Header -->
			<div class="text-center max-w-3xl mx-auto mb-12">
				<span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
					FULL 2D MODULE ARCHITECTURE & DATA FLOW
				</span>
				<h1 class="mt-4 text-4xl sm:text-6xl font-extrabold text-white font-display">
					System Architecture
				</h1>
				<p class="mt-4 text-neutral-400 text-base sm:text-lg leading-relaxed">
					Interactive 2D schematic mapping of data flow between client modules, OpenAPI schemas, server nodes, and the caregiver web platform.
				</p>
			</div>

			<!-- Data Flow Scenario Selector -->
			<div class="max-w-4xl mx-auto mb-10 space-y-3">
				<!-- Top Button: All Platform Modules -->
				<div class="flex justify-center">
					<button id="btn-flow-all" class="flow-tab-btn active w-full sm:w-auto px-6 py-2.5 rounded-xl text-xs font-mono font-bold transition-all bg-sky-500 text-white border border-sky-400 shadow-lg shadow-sky-500/20">
						🌐 All Platform Modules
					</button>
				</div>
				<!-- Bottom Row: 3 Flow Scenario Buttons -->
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
					<button id="btn-flow-local" class="flow-tab-btn px-4 py-2.5 rounded-xl text-xs font-mono font-bold transition-all bg-[#0a0c10] text-neutral-400 border border-white/10 hover:text-emerald-400 hover:border-emerald-500/40">
						🟢 Flow 1: Offline Local Adherence
					</button>
					<button id="btn-flow-sync" class="flow-tab-btn px-4 py-2.5 rounded-xl text-xs font-mono font-bold transition-all bg-[#0a0c10] text-neutral-400 border border-white/10 hover:text-sky-400 hover:border-sky-500/40">
						🔵 Flow 2: E2EE Cloud Sync
					</button>
					<button id="btn-flow-caregiver" class="flow-tab-btn px-4 py-2.5 rounded-xl text-xs font-mono font-bold transition-all bg-[#0a0c10] text-neutral-400 border border-white/10 hover:text-sky-400 hover:border-sky-500/40">
						🔵 Flow 3: Caregiver Alerts
					</button>
				</div>
			</div>

				<!-- Diagram Control & Legend Header Card (With Optional Data Flow Animation Controls) -->
				<div class="p-6 rounded-3xl bg-[#0a0c10]/95 backdrop-blur-2xl border border-white/15 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-8">
					<div>
						<div class="flex items-center space-x-2">
							<h2 class="text-xl font-bold text-white font-display">Topology of the Platform</h2>
							<span id="active-flow-badge" class="text-xs px-2.5 py-0.5 rounded-full font-mono bg-sky-500/10 text-sky-300 border border-sky-500/20">All Platform Modules</span>
							<span class="text-[10px] px-2 py-0.5 rounded-full font-mono font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">Optional Data Flow Animation</span>
						</div>
						<p class="text-xs text-neutral-400 font-mono mt-1 flex items-center space-x-2">
							<span>Select a module to inspect.</span>
							<span id="topo-active-route" class="text-sky-300 font-bold bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/20">Live Route: ☁️ Option A (Managed Cloud)</span>
						</p>
					</div>

					<div class="flex flex-wrap items-center gap-3 text-xs font-mono">
						<!-- Play / Pause Optional Animation Button -->
						<button id="btn-toggle-topo-sim" class="px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-sky-500/10 text-sky-300 border border-sky-500/30 hover:bg-sky-500/20 transition-all flex items-center space-x-1.5">
							<span id="topo-sim-icon" class="animate-spin text-sky-400">⚡</span>
							<span id="topo-sim-status">Pause Flow Animation</span>
						</button>

						<span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
							<span class="w-2 h-2 rounded-full bg-emerald-400"></span>
							<span>Local Engine</span>
						</span>
						<span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-sky-500/10 text-sky-300 border border-sky-500/20">
							<span class="w-2 h-2 rounded-full bg-sky-400"></span>
							<span>OpenAPI 3.0 Spec</span>
						</span>
					</div>
				</div>

				<!-- 2D Graphical Layout (Direct Subcards without outer card wrapper) -->
				<div class="relative space-y-8 mt-2">
					
					<!-- 2D Grid Section 1: Patient Client Application Layer (Width tightly bounded to Android & iOS cards) -->
					<div id="module-layer-client" class="arch-layer p-6 sm:p-8 rounded-3xl bg-[#0a0c10]/95 backdrop-blur-2xl border border-emerald-500/30 shadow-2xl transition-all duration-300 relative max-w-4xl mx-auto overflow-hidden group">
						<!-- Top Right Glow Flare -->
						<div class="absolute -top-12 -right-12 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/20 transition-all duration-500 pointer-events-none"></div>

						<div class="flex flex-col sm:flex-row sm:items-center justify-between mb-5 border-b border-white/10 pb-4 gap-3 relative z-10">
							<div class="flex items-center space-x-2">
								<span class="text-xs sm:text-sm font-mono font-bold text-emerald-400 uppercase tracking-wider flex items-center space-x-2">
									<svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
									<span>PATIENT CLIENT APPLICATION LAYER</span>
								</span>
								<span class="text-[10px] bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20 text-emerald-300 font-mono font-bold">100% Offline Core</span>
							</div>
							<div class="flex items-center space-x-3">
								<span class="text-xs font-mono text-neutral-400 hidden sm:inline">Path: <code class="text-white">/patient</code></span>
								<a href="/patient" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/20 hover:border-emerald-400 transition-all shadow-md">
									<span>Patient Application</span>
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
								</a>
							</div>
						</div>

						<!-- Submodule Grid (Android & iOS Only) -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
							<!-- Node 1A: Android Module with SVG Symbol -->
							<div data-module="android-app" class="arch-node bg-[#030407] p-5 rounded-2xl border border-white/10 hover:border-emerald-400 transition-all cursor-pointer group/node shadow-lg">
								<div class="flex items-center justify-between mb-3">
									<div class="flex items-center space-x-2.5">
										<svg class="w-5 h-5 text-emerald-400 fill-current" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.5029C15.5902 8.3582 13.8535 8.01 12 8.01s-3.5902.3482-5.1366.9404L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.0858.4237 14.3385.01 18.257h23.98c-.4137-3.9185-2.6789-7.1712-6.1085-8.9356z"/>
										</svg>
										<h4 class="font-bold text-white text-base group-hover/node:text-emerald-400">Android Client</h4>
									</div>
									<span class="text-[10px] font-mono bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded border border-emerald-500/20">Kotlin & Compose</span>
								</div>
								<p class="text-xs text-neutral-400 mb-3">Jetpack Compose UI & Background Alarm Services</p>
								<div class="space-y-1.5 font-mono text-[10px]">
									<div class="bg-[#0a0c10] px-2.5 py-1.5 rounded-lg text-neutral-300 flex justify-between border border-white/5">
										<span>Database:</span> <span class="text-emerald-300 font-bold">Room SQLite</span>
									</div>
									<div class="bg-[#0a0c10] px-2.5 py-1.5 rounded-lg text-neutral-300 flex justify-between border border-white/5">
										<span>Scheduler:</span> <span class="text-emerald-300 font-bold">AlarmManager</span>
									</div>
									<div class="bg-[#0a0c10] px-2.5 py-1.5 rounded-lg text-neutral-300 flex justify-between border border-white/5">
										<span>Time Selector:</span> <span class="text-emerald-300 font-bold">12-Hour Grid</span>
									</div>
								</div>
							</div>

							<!-- Node 1B: iOS Module with Grayscale & Coming Soon Badge -->
							<div data-module="ios-app" class="arch-node bg-[#030407] p-5 rounded-2xl border border-white/20 hover:border-white/80 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer group/node shadow-lg relative overflow-hidden">
								<div class="flex items-center justify-between mb-3">
									<div class="flex items-center space-x-2.5">
										<svg class="w-5 h-5 text-white/90 fill-current" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.64-.78 1.08-1.85.96-2.92-.93.04-2.06.62-2.73 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.11-.55 2.75-1.33z"/>
										</svg>
										<h4 class="font-bold text-white text-base group-hover/node:text-white">iOS Client</h4>
									</div>
									<div class="flex items-center space-x-1.5">
										<span class="text-[9px] font-mono bg-white/10 text-white border border-white/20 px-2 py-0.5 rounded font-bold uppercase tracking-wider shadow-sm">Coming Soon</span>
										<span class="text-[10px] font-mono bg-sky-500/10 text-sky-400 px-2 py-0.5 rounded border border-sky-500/20">Swift & SwiftUI</span>
									</div>
								</div>
								<p class="text-xs text-neutral-400 mb-3">SwiftUI App & UserNotifications Native Engine</p>
								<div class="space-y-1.5 font-mono text-[10px]">
									<div class="bg-[#0a0c10] px-2.5 py-1.5 rounded-lg text-neutral-300 flex justify-between border border-white/5">
										<span>Database:</span> <span class="text-sky-300 font-bold">SwiftData</span>
									</div>
									<div class="bg-[#0a0c10] px-2.5 py-1.5 rounded-lg text-neutral-300 flex justify-between border border-white/5">
										<span>Scheduler:</span> <span class="text-sky-300 font-bold">UserNotifications</span>
									</div>
									<div class="bg-[#0a0c10] px-2.5 py-1.5 rounded-lg text-neutral-300 flex justify-between border border-white/5">
										<span>Export:</span> <span class="text-sky-300 font-bold">JSON Archive</span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- 2D Animated Connecting Vectors: Tier 1 -> Tier 2 -->
					<div id="vector-1-2" class="my-8 relative flex items-center justify-center py-4 transition-all">
						<!-- Extra Large Bold Background Flow Arrow -->
						<div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-50">
							<svg class="w-20 h-32 text-sky-400 overflow-visible" viewBox="0 0 48 96" fill="none">
								<path d="M24 0 V72" stroke="currentColor" stroke-width="5" stroke-dasharray="10 6" class="animate-stroke-flow" />
								<polygon points="8,66 24,96 40,66" fill="currentColor" />
							</svg>
						</div>
						
						<!-- Reduced Opacity Payload Badge -->
						<div class="relative z-10 bg-[#0a0c10]/65 backdrop-blur-md px-5 py-2 rounded-full border border-sky-500/30 text-xs font-mono text-neutral-300 flex items-center space-x-2.5 shadow-xl opacity-80 hover:opacity-100 transition-opacity">
							<span class="relative flex h-2 w-2">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-2 w-2 bg-sky-400"></span>
							</span>
							<span>Encrypted Data Sync Payload (OpenAPI Contract)</span>
						</div>
					</div>

					<!-- 2D Grid Section 2: Shared Domain & OpenAPI Contract Layer (Compact & Reduced Opacity) -->
					<div id="module-layer-contract" class="arch-layer p-4 sm:p-5 rounded-2xl bg-[#0a0c10]/90 backdrop-blur-2xl border border-dashed border-sky-400/30 opacity-55 hover:opacity-100 max-w-2xl mx-auto transition-all duration-300 relative shadow-xl overflow-hidden group">
						<!-- Top Right Glow Flare -->
						<div class="absolute -top-10 -right-10 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl group-hover:bg-sky-500/20 transition-all duration-500 pointer-events-none"></div>

						<div class="flex flex-col sm:flex-row sm:items-center justify-between mb-3 border-b border-white/10 pb-2.5 gap-2 relative z-10">
							<div class="flex items-center space-x-2">
								<span class="text-xs font-mono font-bold text-sky-300 uppercase tracking-wider">
									📜 SHARED OPENAPI 3.0 CONTRACT LAYER
								</span>
								<span class="text-[9px] bg-sky-500/10 px-2 py-0.5 rounded-full border border-sky-500/20 text-sky-300 font-mono font-bold">Common Schema</span>
							</div>
							<span class="text-[11px] font-mono text-neutral-400">Spec: <code class="text-white">api/openapi.yaml</code></span>
						</div>
						<p class="text-[11px] text-neutral-400 font-mono mb-3 relative z-10">
							Canonical schema definition dictating platform-wide zero lock-in contract standards.
						</p>

						<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-mono relative z-10">
							<!-- Schema A: Medication -->
							<div data-module="schema-medication" class="arch-node bg-[#030407] p-2.5 rounded-xl border border-white/10 hover:border-sky-400 transition-all cursor-pointer text-center space-y-0.5 shadow-md">
								<span class="text-sky-300 font-bold block text-[11px]">Medication</span>
								<span class="text-[9px] text-neutral-400 block">ID, Dose, Color</span>
							</div>
							<!-- Schema B: Schedule -->
							<div data-module="schema-schedule" class="arch-node bg-[#030407] p-2.5 rounded-xl border border-white/10 hover:border-sky-400 transition-all cursor-pointer text-center space-y-0.5 shadow-md">
								<span class="text-sky-300 font-bold block text-[11px]">Schedule</span>
								<span class="text-[9px] text-neutral-400 block">Interval, Times</span>
							</div>
							<!-- Schema C: DoseEvent -->
							<div data-module="schema-event" class="arch-node bg-[#030407] p-2.5 rounded-xl border border-white/10 hover:border-sky-400 transition-all cursor-pointer text-center space-y-0.5 shadow-md">
								<span class="text-sky-300 font-bold block text-[11px]">DoseEvent</span>
								<span class="text-[9px] text-neutral-400 block">Taken/Missed</span>
							</div>
							<!-- Schema D: CaregiverConsent -->
							<div data-module="schema-consent" class="arch-node bg-[#030407] p-2.5 rounded-xl border border-white/10 hover:border-sky-400 transition-all cursor-pointer text-center space-y-0.5 shadow-md">
								<span class="text-sky-300 font-bold block text-[11px]">Consent</span>
								<span class="text-[9px] text-neutral-400 block">E2EE Tokens</span>
							</div>
						</div>
					</div>

					<!-- 2D Animated Connecting Vectors: Tier 2 -> Tier 3 -->
					<div id="vector-2-3" class="my-8 relative flex items-center justify-center py-4 transition-all">
						<!-- Extra Large Bold Background Flow Arrow -->
						<div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-50">
							<svg class="w-20 h-32 text-indigo-400 overflow-visible" viewBox="0 0 48 96" fill="none">
								<path d="M24 0 V72" stroke="currentColor" stroke-width="5" stroke-dasharray="10 6" class="animate-stroke-flow" />
								<polygon points="8,66 24,96 40,66" fill="currentColor" />
							</svg>
						</div>
						
						<!-- Central Endpoint & Route Badge -->
						<div class="relative z-10 bg-[#0a0c10]/65 backdrop-blur-md px-5 py-2 rounded-full border border-indigo-500/30 text-xs font-mono text-neutral-300 flex items-center space-x-2.5 shadow-xl opacity-80 hover:opacity-100 transition-opacity">
							<span class="relative flex h-2 w-2">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400"></span>
							</span>
							<span id="vector-server-route-badge" class="font-bold text-sky-300 transition-all">Active Flow Route: ☁️ Option A — Managed Cloud (api.dosezy.app)</span>
						</div>
					</div>

					<!-- 2D Grid Section 3: Server Node Infrastructure Layer (With Fixed Server SVG Icon & Flare Glow) -->
					<div id="module-layer-server" class="arch-layer p-6 sm:p-8 rounded-3xl bg-[#0a0c10]/95 backdrop-blur-2xl border border-indigo-500/30 shadow-2xl transition-all duration-300 relative max-w-4xl mx-auto overflow-hidden group">
						<!-- Top Right Glow Flare -->
						<div class="absolute -top-12 -right-12 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl group-hover:bg-indigo-500/20 transition-all duration-500 pointer-events-none"></div>

						<div class="flex flex-col sm:flex-row sm:items-center justify-between mb-5 border-b border-white/10 pb-4 gap-3 relative z-10">
							<div class="flex items-center space-x-2">
								<span class="text-xs sm:text-sm font-mono font-bold text-indigo-300 uppercase tracking-wider flex items-center space-x-2">
									<!-- Fixed Heroicons Server Stack Icon SVG -->
									<svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
									</svg>
									<span>SERVER NODE INFRASTRUCTURE LAYER</span>
								</span>
								<span class="text-[10px] bg-indigo-500/10 px-2.5 py-0.5 rounded-full border border-indigo-500/20 text-indigo-300 font-mono font-bold">Managed Cloud or Self-Hosted Node</span>
							</div>
							<div class="flex items-center space-x-3">
								<span class="text-xs font-mono text-neutral-400 hidden sm:inline">Path: <code class="text-white">/server</code></span>
								<a href="/server" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-mono font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 hover:bg-indigo-500/20 hover:border-indigo-400 transition-all shadow-md">
									<span>Server Node</span>
									<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
								</a>
							</div>
						</div>

						<div class="relative grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch z-10">
							
							<!-- Central Graphic OR Badge -->
							<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 hidden md:flex items-center justify-center">
								<div class="w-10 h-10 rounded-full bg-[#0a0c10] border-2 border-indigo-500/50 text-indigo-300 font-mono font-bold text-xs flex items-center justify-center shadow-xl shadow-indigo-950/80 ring-4 ring-[#12151c]">
									OR
								</div>
							</div>

							<!-- Node 3A: Managed Cloud Platform Server (Option A) -->
							<div data-module="server-cloud" class="arch-node bg-[#030407] p-5 rounded-2xl border border-sky-500/30 hover:border-sky-400 transition-all cursor-pointer group/node relative shadow-lg">
								<div class="flex items-center justify-between mb-2">
									<div class="flex items-center space-x-2">
										<span class="text-lg">☁️</span>
										<h4 class="font-bold text-white text-sm group-hover/node:text-sky-300">Option A: Managed Cloud Node</h4>
									</div>
									<span class="text-[10px] font-mono bg-sky-500/10 text-sky-300 px-2 py-0.5 rounded">api.dosezy.app</span>
								</div>
								<p class="text-xs text-neutral-400 mb-3">Fully managed cloud instance for zero-maintenance family sharing & push alerts.</p>
								<div class="grid grid-cols-2 gap-2 text-[10px] font-mono text-neutral-300">
									<div class="bg-[#0a0c10] p-2 rounded-lg border border-white/5">Multi-Tenant PostgreSQL</div>
									<div class="bg-[#0a0c10] p-2 rounded-lg border border-white/5">Push Notification Engine</div>
									<div class="bg-[#0a0c10] p-2 rounded-lg border border-white/5">SMS / Email Alert Queue</div>
									<div class="bg-[#0a0c10] p-2 rounded-lg border border-white/5">E2EE Key Exchange</div>
								</div>
							</div>

							<!-- Mobile OR Graphic Badge -->
							<div class="flex md:hidden items-center justify-center my-1">
