	document.addEventListener('DOMContentLoaded', () => {
		const nodes = document.querySelectorAll<HTMLElement>('.arch-node');
		const activeFlowBadge = document.getElementById('active-flow-badge');

		// Tab Buttons
		const btnAll = document.getElementById('btn-flow-all');
		const btnLocal = document.getElementById('btn-flow-local');
		const btnSync = document.getElementById('btn-flow-sync');
		const btnCaregiver = document.getElementById('btn-flow-caregiver');

		// Node Click Event
		nodes.forEach(node => {
			node.addEventListener('click', () => {
				// Highlight active node
				nodes.forEach(n => n.classList.remove('ring-2', 'ring-sky-400', 'border-sky-400'));
				node.classList.add('ring-2', 'ring-sky-400', 'border-sky-400');
			});
		});

		// Flow Filtering logic
		function filterFlow(flow: 'all' | 'local' | 'sync' | 'caregiver') {
			// Update Tab Styles
			[btnAll, btnLocal, btnSync, btnCaregiver].forEach(btn => {
				if (!btn) return;
				btn.classList.remove('bg-sky-500', 'text-white', 'border-sky-400', 'shadow-lg');
				btn.classList.add('bg-[#0a0c10]', 'text-neutral-400', 'border-white/10');
			});

			const activeBtn = flow === 'all' ? btnAll : flow === 'local' ? btnLocal : flow === 'sync' ? btnSync : btnCaregiver;
			if (activeBtn) {
				activeBtn.classList.remove('bg-[#0a0c10]', 'text-neutral-400', 'border-white/10');
				activeBtn.classList.add('bg-sky-500', 'text-white', 'border-sky-400', 'shadow-lg');
			}

			if (activeFlowBadge) {
				activeFlowBadge.textContent = flow === 'all' ? 'Topology of the Platform' : flow === 'local' ? 'Flow 1: Local Adherence' : flow === 'sync' ? 'Flow 2: Cloud Sync' : 'Flow 3: Caregiver Alerts';
			}

			// Layer & Vector Visibility
			const layerClient = document.getElementById('module-layer-client');
			const layerContract = document.getElementById('module-layer-contract');
			const layerServer = document.getElementById('module-layer-server');
			const layerCaregiver = document.getElementById('module-layer-caregiver');
			const vec12 = document.getElementById('vector-1-2');
			const vec23 = document.getElementById('vector-2-3');
			const vec34 = document.getElementById('vector-3-4');

			if (flow === 'all') {
				[layerClient, layerContract, layerServer, layerCaregiver].forEach(l => l?.classList.remove('opacity-30'));
				[vec12, vec23, vec34].forEach(v => v?.classList.remove('opacity-20'));
			} else if (flow === 'local') {
				layerClient?.classList.remove('opacity-30');
				[layerContract, layerServer, layerCaregiver].forEach(l => l?.classList.add('opacity-30'));
				[vec12, vec23, vec34].forEach(v => v?.classList.add('opacity-20'));
			} else if (flow === 'sync') {
				[layerClient, layerContract, layerServer].forEach(l => l?.classList.remove('opacity-30'));
				layerCaregiver?.classList.add('opacity-30');
				[vec12, vec23].forEach(v => v?.classList.remove('opacity-20'));
				vec34?.classList.add('opacity-20');
			} else if (flow === 'caregiver') {
				[layerClient, layerContract, layerServer, layerCaregiver].forEach(l => l?.classList.remove('opacity-30'));
				[vec12, vec23, vec34].forEach(v => v?.classList.remove('opacity-20'));
			}
		}

		btnAll?.addEventListener('click', () => filterFlow('all'));
		btnLocal?.addEventListener('click', () => filterFlow('local'));
		btnSync?.addEventListener('click', () => filterFlow('sync'));
		btnCaregiver?.addEventListener('click', () => filterFlow('caregiver'));

		// Optional Topology Data Flow Alternating Controller (Directly in existing topology layout)
		const btnToggleTopoSim = document.getElementById('btn-toggle-topo-sim');
		const topoSimIcon = document.getElementById('topo-sim-icon');
		const topoSimStatus = document.getElementById('topo-sim-status');
		const topoActiveRoute = document.getElementById('topo-active-route');
		const vectorServerRouteBadge = document.getElementById('vector-server-route-badge');
		const nodeCloud = document.querySelector<HTMLElement>('[data-module="server-cloud"]');
		const nodeSelfHosted = document.querySelector<HTMLElement>('[data-module="server-selfhosted"]');
		const nodeCaregiverCloud = document.querySelector<HTMLElement>('[data-module="caregiver-cloud"]');
		const nodeCaregiverSelfHosted = document.querySelector<HTMLElement>('[data-module="caregiver-selfhosted"]');

		let isCloudActive = true;
		let isTopoSimRunning = true;
		let topoInterval: any = null;

		function applyTopologyServerHighlight(isCloud: boolean) {
			isCloudActive = isCloud;

			if (isCloudActive) {
				if (nodeCloud) {
					nodeCloud.classList.add('border-sky-400', 'ring-2', 'ring-sky-400/50', 'shadow-sky-500/30', 'scale-[1.01]');
					nodeCloud.classList.remove('opacity-40');
				}
				if (nodeSelfHosted) {
					nodeSelfHosted.classList.remove('border-indigo-400', 'ring-2', 'ring-indigo-400/50', 'shadow-indigo-500/30', 'scale-[1.01]');
					nodeSelfHosted.classList.add('opacity-40');
				}
				if (nodeCaregiverCloud) {
					nodeCaregiverCloud.classList.add('border-sky-400', 'ring-2', 'ring-sky-400/50', 'shadow-sky-500/30', 'scale-[1.01]');
					nodeCaregiverCloud.classList.remove('opacity-40');
				}
				if (nodeCaregiverSelfHosted) {
					nodeCaregiverSelfHosted.classList.remove('border-indigo-400', 'ring-2', 'ring-indigo-400/50', 'shadow-indigo-500/30', 'scale-[1.01]');
					nodeCaregiverSelfHosted.classList.add('opacity-40');
				}
				if (topoActiveRoute) {
					topoActiveRoute.textContent = 'Live Route: ☁️ Option A (Managed Cloud)';
					topoActiveRoute.className = 'text-sky-300 font-bold bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/20';
				}
				if (vectorServerRouteBadge) {
					vectorServerRouteBadge.textContent = 'Active Flow Route: ☁️ Option A — Managed Cloud (api.dosezy.app)';
					vectorServerRouteBadge.className = 'font-bold text-sky-300 transition-all';
				}
			} else {
				if (nodeSelfHosted) {
					nodeSelfHosted.classList.add('border-indigo-400', 'ring-2', 'ring-indigo-400/50', 'shadow-indigo-500/30', 'scale-[1.01]');
					nodeSelfHosted.classList.remove('opacity-40');
				}
				if (nodeCloud) {
					nodeCloud.classList.remove('border-sky-400', 'ring-2', 'ring-sky-400/50', 'shadow-sky-500/30', 'scale-[1.01]');
					nodeCloud.classList.add('opacity-40');
				}
				if (nodeCaregiverSelfHosted) {
					nodeCaregiverSelfHosted.classList.add('border-indigo-400', 'ring-2', 'ring-indigo-400/50', 'shadow-indigo-500/30', 'scale-[1.01]');
					nodeCaregiverSelfHosted.classList.remove('opacity-40');
				}
				if (nodeCaregiverCloud) {
					nodeCaregiverCloud.classList.remove('border-sky-400', 'ring-2', 'ring-sky-400/50', 'shadow-sky-500/30', 'scale-[1.01]');
					nodeCaregiverCloud.classList.add('opacity-40');
				}
				if (topoActiveRoute) {
					topoActiveRoute.textContent = 'Live Route: 🏡 Option B (Self-Hosted Node & Caregiver Portal)';
					topoActiveRoute.className = 'text-indigo-300 font-bold bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/20';
				}
				if (vectorServerRouteBadge) {
					vectorServerRouteBadge.textContent = 'Active Flow Route: 🏡 Option B — Self-Hosted Node & Portal (Docker Homelab)';
					vectorServerRouteBadge.className = 'font-bold text-indigo-300 transition-all';
				}
			}
		}

		function startTopoAlternating() {
			if (topoInterval) clearInterval(topoInterval);
			topoInterval = setInterval(() => {
				if (isTopoSimRunning) {
					applyTopologyServerHighlight(!isCloudActive);
				}
			}, 3500);
		}

		applyTopologyServerHighlight(true);
		startTopoAlternating();

		btnToggleTopoSim?.addEventListener('click', () => {
			isTopoSimRunning = !isTopoSimRunning;
			if (isTopoSimRunning) {
				if (topoSimIcon) topoSimIcon.className = 'animate-spin text-sky-400';
				if (topoSimStatus) topoSimStatus.textContent = 'Pause Flow Animation';
				applyTopologyServerHighlight(!isCloudActive);
			} else {
				if (topoSimIcon) topoSimIcon.className = 'text-neutral-400';
				if (topoSimStatus) topoSimStatus.textContent = 'Resume Flow Animation';
			}
		});
	});
</script>

<style>
	.animate-stroke-flow {
		animation: strokeFlow 1.5s linear infinite;
	}
	@keyframes strokeFlow {
		from {
			stroke-dashoffset: 0;
		}
		to {
			stroke-dashoffset: -20;
		}
	}
	.animate-packet-slide {
		animation: packetSlide 3.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
	}
	@keyframes packetSlide {
		0% {
			left: 0%;
			opacity: 0;
		}
		15% {
			opacity: 1;
		}
		85% {
			opacity: 1;
		}
		100% {
			left: 80%;
			opacity: 0;
		}
	}
</style>
