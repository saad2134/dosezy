---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Patient Application ✦ Dosezy Free Offline Medicine Tracker">
	<Header />
	<main class="flex-grow pt-28 sm:pt-32 pb-16 bg-[#030407] bg-grid-pattern">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<!-- Hero Header -->
			<div class="text-center max-w-3xl mx-auto mb-16">
				<span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
					DOSEZY PATIENT CLIENT (v2.3.0)
				</span>
				<h1 class="mt-4 text-4xl sm:text-6xl font-extrabold text-white font-display">
					Patient Application
				</h1>
				<p class="mt-4 text-neutral-400 text-lg leading-relaxed">
					Transforming daily medication management into a stress-free experience. Engineered for elderly users, multi-prescription tracking, and 100% data privacy.
				</p>
			</div>

			<!-- Android / iOS Patient Client Split Section -->
			<div class="max-w-6xl mx-auto mb-16 relative">
				<!-- Enhanced Central Graphic OR Badge -->
				<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 hidden md:flex flex-col items-center justify-center pointer-events-none">
					<div class="w-11 h-11 rounded-full bg-[#0a0c10]/95 border-2 border-emerald-400/60 text-emerald-300 font-mono font-extrabold text-xs flex items-center justify-center shadow-[0_0_20px_rgba(16,185,129,0.3)] ring-4 ring-[#030407]">
						OR
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
					
					<!-- Card 1: Android Patient Client Module (With Downloads Section & Highlight ID) -->
					<div id="card-android" class="vercel-card p-6 sm:p-8 rounded-3xl border border-emerald-500/30 bg-[#0a0c10]/95 relative overflow-hidden group shadow-2xl flex flex-col justify-between h-full transition-all duration-500">
						<!-- Top Right Glow Flare -->
						<div class="absolute -top-12 -right-12 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/20 transition-all duration-500 pointer-events-none"></div>

						<div class="flex-1 flex flex-col justify-between">
							<!-- Header with exact matching height -->
							<div class="flex flex-wrap items-center justify-between mb-6 border-b border-white/10 pb-4 min-h-[68px] gap-2">
								<div class="flex items-center space-x-3">
									<svg class="w-8 h-8 text-emerald-400 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993s-.4482.9997-.9993.9997zm11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1523-.5676.416.416 0 00-.5676.1523l-2.0223 3.5029C15.5902 8.3582 13.8535 8.01 12 8.01s-3.5902.3482-5.1366.9404L4.8411 5.4475a.416.416 0 00-.5676-.1523.416.416 0 00-.1523.5676l1.9973 3.4592C2.6889 11.0858.4237 14.3385.01 18.257h23.98c-.4137-3.9185-2.6789-7.1712-6.1085-8.9356z"/>
									</svg>
									<div>
										<h3 class="text-xl font-bold text-white font-display">Android Client</h3>
										<p class="text-xs font-mono text-emerald-400">patient/android</p>
									</div>
								</div>
								<span class="px-2.5 py-1 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 font-bold">
									Kotlin & Compose
								</span>
							</div>

							<!-- Body Sections with flex grow to push download divider to equal height -->
							<div class="space-y-4 text-xs leading-relaxed flex-1 flex flex-col justify-between mb-4">
								<div>
									<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-1.5 text-[11px]">Primary Responsibilities</h4>
									<p class="text-neutral-300">
										Built for seamless daily medication tracking. Manages your schedules locally, fires high-priority full-screen alarms even when your phone is asleep, includes an emergency contact dialer, and works 100% offline.
									</p>
								</div>

								<div>
									<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-1.5 text-[11px]">Data Inputs & Outputs</h4>
									<ul class="space-y-1 font-mono text-neutral-400">
										<li class="flex items-start space-x-2"><span class="text-emerald-400">📥</span> <span>Easy 12-Hour visual schedule picker</span></li>
										<li class="flex items-start space-x-2"><span class="text-sky-400">💾</span> <span>Private local database stored on your device</span></li>
										<li class="flex items-start space-x-2"><span class="text-purple-400">📤</span> <span>(Optional) Secure end-to-end encrypted cloud sync</span></li>
									</ul>
								</div>

								<div>
									<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-1.5 text-[11px]">Security & Privacy Boundary</h4>
									<p class="text-neutral-300 font-mono text-[11px] bg-[#030407] p-3 rounded-xl border border-white/5">
										🔒 Zero telemetry, zero external trackers, encrypted local storage, and instant offline fallback.
									</p>
								</div>
							</div>
						</div>

						<!-- Download Section starting at exact same height -->
						<div class="mt-2 pt-4 border-t border-white/10 shrink-0 space-y-3">
							<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-2 text-[11px]">Downloads</h4>
							<div class="flex flex-wrap items-center gap-3">
								<a href="https://f-droid.org/en/packages/com.saad2134.dosezy" target="_blank" rel="noopener noreferrer" class="inline-block hover:scale-105 transition-transform">
									<img src="/get-it-on-fdroid.png" alt="Get it on F-Droid" class="h-10 w-auto" />
								</a>
								<a href="https://github.com/saad2134/dosezy/releases" target="_blank" rel="noopener noreferrer" class="inline-block hover:scale-105 transition-transform">
									<img src="/get-it-on-github.png" alt="Get it on GitHub" class="h-10 w-auto" />
								</a>
							</div>
							<!-- SHA-256 Integrity Verification Banner -->
							<div class="pt-2 border-t border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between text-[10px] font-mono gap-1.5">
								<span class="text-neutral-400">Release Hash Verification (SHA-256):</span>
								<code class="text-emerald-300 bg-black/60 px-2 py-0.5 rounded border border-white/10 text-[10px] break-all">
									c57df39a-b714-4e82-8420-42c003c072f7
								</code>
							</div>
						</div>
					</div>

					<!-- Mobile OR Graphic Badge -->
					<div class="flex md:hidden items-center justify-center my-1">
						<span class="px-4 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg">
							— EITHER / OR —
						</span>
					</div>

					<!-- Card 2: iOS Patient Client Module (With Grayscale & Coming Soon Label & Highlight ID) -->
					<div id="card-ios" class="vercel-card p-6 sm:p-8 rounded-3xl border border-white/20 hover:border-white/80 bg-[#0a0c10]/95 grayscale opacity-65 hover:grayscale-0 hover:opacity-100 transition-all duration-500 relative overflow-hidden group shadow-2xl flex flex-col justify-between h-full">
						<!-- Top Right Glow Flare (Apple White Theme) -->
						<div class="absolute -top-12 -right-12 w-64 h-64 bg-white/10 rounded-full blur-3xl group-hover:bg-white/20 transition-all duration-500 pointer-events-none"></div>

						<div class="flex-1 flex flex-col justify-between">
							<!-- Header with exact matching height -->
							<div class="flex flex-wrap items-center justify-between mb-6 border-b border-white/10 pb-4 min-h-[68px] gap-2">
								<div class="flex items-center space-x-3">
									<svg class="w-8 h-8 text-white/90 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.32c.64-.78 1.08-1.85.96-2.92-.93.04-2.06.62-2.73 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.11-.55 2.75-1.33z"/>
									</svg>
									<div>
										<h3 class="text-xl font-bold text-white font-display">iOS Client</h3>
										<p class="text-xs font-mono text-neutral-300 font-bold">patient/ios</p>
									</div>
								</div>
								<div class="flex items-center space-x-1.5">
									<span class="text-[10px] font-mono bg-white/10 text-white border border-white/20 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider shadow-sm">Coming Soon</span>
									<span class="px-2.5 py-1 rounded-full text-[10px] font-mono bg-sky-500/10 text-sky-300 border border-sky-500/20 font-bold">
										Swift & SwiftUI
									</span>
								</div>
							</div>

							<!-- Body Sections with flex grow to push download divider to equal height -->
							<div class="space-y-4 text-xs leading-relaxed flex-1 flex flex-col justify-between mb-4">
								<div>
									<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-1.5 text-[11px]">Primary Responsibilities</h4>
									<p class="text-neutral-300">
										Crafted specifically for iPhone users. Delivers precise local dose notifications, effortless schedule creation with a visual grid interface, and private local storage that never relies on external cloud servers.
									</p>
								</div>

								<div>
									<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-1.5 text-[11px]">Data Inputs & Outputs</h4>
									<ul class="space-y-1 font-mono text-neutral-400">
										<li class="flex items-start space-x-2"><span class="text-sky-400">📥</span> <span>Simple tap-and-set schedule grid</span></li>
										<li class="flex items-start space-x-2"><span class="text-sky-400">💾</span> <span>Secure local iOS device & Keychain storage</span></li>
										<li class="flex items-start space-x-2"><span class="text-purple-400">📤</span> <span>(Optional) Encrypted health data backup archive</span></li>
									</ul>
								</div>

								<div>
									<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-1.5 text-[11px]">Security & Privacy Boundary</h4>
									<p class="text-neutral-300 font-mono text-[11px] bg-[#030407] p-3 rounded-xl border border-white/5">
										🔒 Hardware-backed Apple Secure Enclave protection, zero trackers, zero telemetry, and complete data isolation.
									</p>
								</div>
							</div>
						</div>

						<!-- Download Section starting at exact same height -->
						<div class="mt-2 pt-4 border-t border-white/10 shrink-0">
							<h4 class="font-bold text-white font-mono uppercase tracking-wider mb-2 text-[11px]">Downloads</h4>
							<div class="flex items-center justify-center h-10 bg-white/5 rounded-xl border border-white/10 px-4">
								<span class="text-xs font-mono font-bold text-white/80 uppercase tracking-wider flex items-center space-x-2">
									<span>🍎 App Store & TestFlight — Coming Soon</span>
								</span>
							</div>
						</div>
					</div>

				</div>
			</div>

			<!-- Standalone Key Features Section -->
			<div class="mb-16">
				<div class="text-center max-w-3xl mx-auto mb-10">
					<span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">
						PLATFORM CAPABILITIES
					</span>
					<h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white font-display">
						Key Features
					</h2>
				</div>

				<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
					
					<!-- Feature 1: 12-Hour Grid Picker -->
					<div class="vercel-card p-6 rounded-2xl relative overflow-hidden group">
						<div class="absolute -top-10 -right-10 w-36 h-36 bg-amber-500/10 rounded-full blur-2xl group-hover:bg-amber-500/20 transition-all"></div>
						<div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-xl mb-4">⏰</div>
						<h3 class="text-lg font-bold text-white font-display">12-Hour Grid Picker</h3>
						<p class="mt-2 text-xs text-neutral-400 leading-relaxed">
							Replaces circular clock dials with stationary hour and minute buttons, eliminating motor tremor difficulties and input latency.
						</p>
					</div>

					<!-- Feature 2: 100% Offline Privacy -->
					<div class="vercel-card p-6 rounded-2xl relative overflow-hidden group">
						<div class="absolute -top-10 -right-10 w-36 h-36 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
						<div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-xl mb-4">🔒</div>
						<h3 class="text-lg font-bold text-white font-display">100% Offline Privacy</h3>
						<p class="mt-2 text-xs text-neutral-400 leading-relaxed">
							Manifest-enforced omission of internet permissions ensures your medical history stays strictly stored on your own local device.
						</p>
					</div>

					<!-- Feature 3: SIM ISO Emergency Dialer -->
					<div class="vercel-card p-6 rounded-2xl relative overflow-hidden group">
						<div class="absolute -top-10 -right-10 w-36 h-36 bg-rose-500/10 rounded-full blur-2xl group-hover:bg-rose-500/20 transition-all"></div>
						<div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-xl mb-4">🚨</div>
						<h3 class="text-lg font-bold text-white font-display">SIM ISO Emergency Dialer</h3>
						<p class="mt-2 text-xs text-neutral-400 leading-relaxed">
							Auto-detects country emergency services (US 911, EU 112, UK 999, India 112) without requiring an internet connection.
						</p>
					</div>

					<!-- Feature 4: Local-First Architecture -->
					<div class="vercel-card p-6 rounded-2xl relative overflow-hidden group">
						<div class="absolute -top-10 -right-10 w-36 h-36 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
						<div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold mb-4 font-mono text-sm">1</div>
						<h3 class="text-lg font-bold text-white font-display">Local-First Architecture</h3>
						<p class="mt-2 text-xs text-neutral-400 leading-relaxed">
							All core functions (alarms, tracking, PDF reports, emergency dialer) operate strictly within local Room/SwiftData databases on-device with 0% network dependency.
						</p>
					</div>

					<!-- Feature 5: Contract-Driven Schemas -->
					<div class="vercel-card p-6 rounded-2xl relative overflow-hidden group">
						<div class="absolute -top-10 -right-10 w-36 h-36 bg-sky-500/10 rounded-full blur-2xl group-hover:bg-sky-500/20 transition-all"></div>
						<div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 font-bold mb-4 font-mono text-sm">2</div>
						<h3 class="text-lg font-bold text-white font-display">Contract-Driven Schemas</h3>
						<p class="mt-2 text-xs text-neutral-400 leading-relaxed">
							The shared <code class="text-sky-300 font-mono">api/openapi.yaml</code> defines canonical data contracts, ensuring complete compatibility across Android, iOS, Server, and Caregiver web apps.
						</p>
					</div>

					<!-- Feature 6: Server Node Agnostic -->
					<div class="vercel-card p-6 rounded-2xl relative overflow-hidden group">
						<div class="absolute -top-10 -right-10 w-36 h-36 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all"></div>
						<div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold mb-4 font-mono text-sm">3</div>
						<h3 class="text-lg font-bold text-white font-display">Server Node Agnostic</h3>
						<p class="mt-2 text-xs text-neutral-400 leading-relaxed">
							Patients can seamlessly connect to either a self-hosted community server node or the official managed cloud platform without locking in data.
						</p>
					</div>

				</div>
			</div>

			<!-- Standalone Application Interfaces Section with Carousel Controls -->
			<div class="max-w-6xl mx-auto mb-16">
				<!-- Standalone Section Title -->
				<div class="text-center max-w-3xl mx-auto mb-10">
					<span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
						VISUAL GALLERY
					</span>
					<h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white font-display">
						Application Interfaces
					</h2>
					<p class="mt-2 text-neutral-400 text-sm leading-relaxed">
						Explore the native screens engineered for accessible medication scheduling, high-visibility alarms, and offline data export.
					</p>
				</div>

				<!-- Carousel Box with Left/Right Scroll Buttons -->
				<div class="vercel-card p-6 sm:p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 relative overflow-hidden group shadow-2xl">
					<!-- Top Right Glow Flare -->
					<div class="absolute -top-12 -right-12 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl group-hover:bg-sky-500/20 transition-all duration-500 pointer-events-none"></div>

					<!-- Header Bar with Navigation Controls -->
					<div class="flex items-center justify-between mb-6 pb-4 border-b border-white/10 relative z-10">
						<div class="flex items-center space-x-2 text-xs font-mono text-neutral-400">
							<span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
							<span>Interactive Screen Gallery</span>
						</div>
						<div class="flex items-center space-x-2">
							<button id="carousel-prev" aria-label="Previous image" class="p-2 rounded-xl bg-[#030407] text-neutral-300 border border-white/10 hover:border-sky-400 hover:text-sky-300 transition-all shadow-md active:scale-95">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
							</button>
							<button id="carousel-next" aria-label="Next image" class="p-2 rounded-xl bg-[#030407] text-neutral-300 border border-white/10 hover:border-sky-400 hover:text-sky-300 transition-all shadow-md active:scale-95">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
							</button>
						</div>
					</div>

					<!-- Scrollable Screenshot Grid / Track -->
					<div id="interface-carousel" class="flex space-x-5 overflow-x-auto scrollbar-none scroll-smooth pb-3 relative z-10">
						
						<!-- Screen 1: Home Dashboard -->
						<div class="min-w-[210px] sm:min-w-[230px] flex-1 space-y-2.5 text-center group/screen shrink-0">
							<div class="rounded-2xl overflow-hidden border border-white/10 bg-[#030407] p-1.5 shadow-xl transition-all duration-300 group-hover/screen:border-sky-500/50 group-hover/screen:scale-105">
								<img src="/screenshots/home.png" alt="Home Screen" class="w-full h-auto rounded-xl" />
							</div>
							<span class="text-xs font-mono text-neutral-300 font-semibold block">Home Dashboard</span>
						</div>

						<!-- Screen 2: Schedule Calendar -->
						<div class="min-w-[210px] sm:min-w-[230px] flex-1 space-y-2.5 text-center group/screen shrink-0">
							<div class="rounded-2xl overflow-hidden border border-white/10 bg-[#030407] p-1.5 shadow-xl transition-all duration-300 group-hover/screen:border-sky-500/50 group-hover/screen:scale-105">
								<img src="/screenshots/schedule.png" alt="Schedule Screen" class="w-full h-auto rounded-xl" />
							</div>
							<span class="text-xs font-mono text-neutral-300 font-semibold block">Schedule Calendar</span>
						</div>

						<!-- Screen 3: Medicine Vault -->
						<div class="min-w-[210px] sm:min-w-[230px] flex-1 space-y-2.5 text-center group/screen shrink-0">
							<div class="rounded-2xl overflow-hidden border border-white/10 bg-[#030407] p-1.5 shadow-xl transition-all duration-300 group-hover/screen:border-sky-500/50 group-hover/screen:scale-105">
								<img src="/screenshots/medicines.png" alt="Medicines Screen" class="w-full h-auto rounded-xl" />
							</div>
							<span class="text-xs font-mono text-neutral-300 font-semibold block">Medicine Vault</span>
						</div>

						<!-- Screen 4: Grid Time Selector -->
						<div class="min-w-[210px] sm:min-w-[230px] flex-1 space-y-2.5 text-center group/screen shrink-0">
							<div class="rounded-2xl overflow-hidden border border-white/10 bg-[#030407] p-1.5 shadow-xl transition-all duration-300 group-hover/screen:border-sky-500/50 group-hover/screen:scale-105">
								<img src="/screenshots/add-med.png" alt="Add Medicine Screen" class="w-full h-auto rounded-xl" />
							</div>
							<span class="text-xs font-mono text-neutral-300 font-semibold block">Grid Time Selector</span>
						</div>

						<!-- Screen 5: PDF & Data Export -->
						<div class="min-w-[210px] sm:min-w-[230px] flex-1 space-y-2.5 text-center group/screen shrink-0">
							<div class="rounded-2xl overflow-hidden border border-white/10 bg-[#030407] p-1.5 shadow-xl transition-all duration-300 group-hover/screen:border-sky-500/50 group-hover/screen:scale-105">
								<img src="/screenshots/export.png" alt="Export Screen" class="w-full h-auto rounded-xl" />
							</div>
							<span class="text-xs font-mono text-neutral-300 font-semibold block">PDF & Data Export</span>
						</div>

					</div>
				</div>
			</div>

		</div>
	</main>
	<Footer />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// URL Parameter & Hash Detection for ?platform=android or ?platform=ios
		const urlParams = new URLSearchParams(window.location.search);
		const platformParam = urlParams.get('platform')?.toLowerCase() || window.location.hash.replace('#', '').toLowerCase();

		if (platformParam) {
			let targetCard: HTMLElement | null = null;
			let highlightClass = '';

			if (platformParam === 'android' || platformParam === 'patient-android') {
				targetCard = document.getElementById('card-android');
				highlightClass = 'animate-pulse-android';
			} else if (platformParam === 'ios' || platformParam === 'patient-ios') {
				targetCard = document.getElementById('card-ios');
				highlightClass = 'animate-pulse-ios';
			}

			if (targetCard) {
				// Smooth scroll to target platform card
				setTimeout(() => {
					targetCard?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}, 150);

				// Add glowing pulse highlight animation
				targetCard.classList.add(highlightClass);

				// After 4.5s pulse cycles, settle into active ring highlight
				setTimeout(() => {
					targetCard?.classList.remove(highlightClass);
					if (platformParam === 'android' || platformParam === 'patient-android') {
						targetCard?.classList.add('ring-2', 'ring-emerald-400', 'shadow-[0_0_30px_rgba(16,185,129,0.5)]');
					} else {
						targetCard?.classList.add('ring-2', 'ring-amber-400', 'shadow-[0_0_30px_rgba(245,158,11,0.5)]');
					}
				}, 4500);
			}
		}

		// Carousel Navigation Controls
		const carousel = document.getElementById('interface-carousel');
		const btnPrev = document.getElementById('carousel-prev');
		const btnNext = document.getElementById('carousel-next');

		btnPrev?.addEventListener('click', () => {
			carousel?.scrollBy({ left: -260, behavior: 'smooth' });
		});

		btnNext?.addEventListener('click', () => {
			carousel?.scrollBy({ left: 260, behavior: 'smooth' });
		});
	});
</script>

<style>
	@keyframes pulseAndroidGlow {
		0%, 100% {
			transform: scale(1);
			box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
			border-color: rgba(16, 185, 129, 0.4);
		}
		50% {
			transform: scale(1.02);
			box-shadow: 0 0 45px rgba(16, 185, 129, 0.85), 0 0 90px rgba(16, 185, 129, 0.45);
			border-color: rgba(16, 185, 129, 1);
		}
	}

	@keyframes pulseIosGlow {
		0%, 100% {
			transform: scale(1);
			box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
			border-color: rgba(245, 158, 11, 0.4);
		}
		50% {
			transform: scale(1.02);
			box-shadow: 0 0 45px rgba(245, 158, 11, 0.85), 0 0 90px rgba(245, 158, 11, 0.45);
			border-color: rgba(245, 158, 11, 1);
		}
	}

	.animate-pulse-android {
		animation: pulseAndroidGlow 1.2s cubic-bezier(0.4, 0, 0.2, 1) 4;
		z-index: 30;
	}

	.animate-pulse-ios {
		animation: pulseIosGlow 1.2s cubic-bezier(0.4, 0, 0.2, 1) 4;
		z-index: 30;
	}
</style>
