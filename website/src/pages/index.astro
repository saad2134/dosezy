---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InteractiveGridPicker from '../components/InteractiveGridPicker.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import FutureRoadmap from '../components/FutureRoadmap.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Dosezy ✦ Free, Open Source & Private Medicine Tracker">
	<Header />
	<main class="flex-grow">
		<Hero />
		<InteractiveGridPicker />
		<FeatureGrid />
		<FutureRoadmap />
		<DownloadSection />
	</main>
	<Footer />
</Layout>
