---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact & Support ✦ Dosezy">
	<Header />
	<main class="flex-grow pt-28 sm:pt-32 pb-16 bg-[#030407] bg-grid-pattern relative overflow-hidden">
		<!-- Background Glow Spotlights -->
		<div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-sky-500/10 blur-[130px] rounded-full pointer-events-none"></div>
		<div class="absolute top-2/3 right-10 w-[400px] h-[300px] bg-indigo-500/10 blur-[120px] rounded-full pointer-events-none"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			
			<!-- Hero Header -->
			<div class="text-center max-w-3xl mx-auto mb-16">
				<span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/20">
					GET IN TOUCH
				</span>
				<h1 class="mt-4 text-4xl sm:text-6xl font-extrabold text-white font-display tracking-tight">
					Contact & Support
				</h1>
				<p class="mt-4 text-neutral-400 text-base sm:text-lg leading-relaxed">
					Have questions about local-first medication tracking, server deployment, caregiver sync, or open-source contribution? We're here to help.
				</p>
			</div>

			<!-- Quick Contact Channels Grid -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
				
				<!-- Channel 1: Community Support -->
				<div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
					<div>
						<div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white font-display mb-2">Community Q&A</h3>
						<p class="text-xs text-neutral-400 leading-relaxed mb-6">
							Ask setup questions, suggest feature improvements, or get help from the developer community on GitHub Discussions.
						</p>
					</div>
					<a 
						href="https://github.com/saad2134/dosezy/discussions" 
						target="_blank" 
						rel="noopener noreferrer"
						class="w-full py-3 px-4 rounded-xl bg-white/5 border border-white/10 text-white text-xs font-bold hover:bg-white/10 transition-all flex items-center justify-center space-x-2 group-hover:border-sky-500/40"
					>
						<span>Open Discussions</span>
						<svg class="w-4 h-4 text-neutral-400 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
						</svg>
					</a>
				</div>

				<!-- Channel 2: Security & Privacy -->
				<div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
					<div>
						<div class="w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white font-display mb-2">Security Disclosures</h3>
						<p class="text-xs text-neutral-400 leading-relaxed mb-6">
							Discovered a potential vulnerability? Review our Security Policy for encrypted, coordinated disclosure channels.
						</p>
					</div>
					<a 
						href="https://github.com/saad2134/dosezy/blob/main/SECURITY.md" 
						target="_blank" 
						rel="noopener noreferrer"
						class="w-full py-3 px-4 rounded-xl bg-white/5 border border-white/10 text-white text-xs font-bold hover:bg-white/10 transition-all flex items-center justify-center space-x-2 group-hover:border-indigo-500/40"
					>
						<span>Security Policy</span>
						<svg class="w-4 h-4 text-neutral-400 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
						</svg>
					</a>
				</div>

				<!-- Channel 3: Caregiver & Server Node -->
				<div class="vercel-card p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 flex flex-col justify-between group">
					<div>
						<div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
							<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2" />
							</svg>
						</div>
						<h3 class="text-xl font-bold text-white font-display mb-2">Cloud & Server Deployment</h3>
						<p class="text-xs text-neutral-400 leading-relaxed mb-6">
							Questions about self-hosting the Dosezy Server Node or setting up Managed Caregiver Cloud synchronization?
						</p>
					</div>
					<a 
						href="/pricing" 
						class="w-full py-3 px-4 rounded-xl bg-white/5 border border-white/10 text-white text-xs font-bold hover:bg-white/10 transition-all flex items-center justify-center space-x-2 group-hover:border-emerald-500/40"
					>
						<span>Explore Cloud Plans</span>
						<svg class="w-4 h-4 text-neutral-400 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>
				</div>

			</div>

			<!-- Main Interactive Contact Form & Recommended Email Options Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
				
				<!-- Column 1: Contact Form (7 Cols) -->
				<div class="lg:col-span-7">
					<div class="vercel-card p-6 sm:p-8 rounded-3xl border border-white/10 bg-[#0a0c10]/95 shadow-2xl relative overflow-hidden h-full flex flex-col justify-between">
						<div class="mb-6 pb-4 border-b border-white/10 flex items-center space-x-3.5 shrink-0">
							<div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 shrink-0">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
								</svg>
							</div>
							<div>
								<h2 class="text-2xl font-extrabold text-white font-display">Send Us a Direct Message</h2>
								<p class="mt-0.5 text-xs text-neutral-400">
									Fill out the form below and our maintainer team will reach out to your inbox.
								</p>
							</div>
						</div>

						<form id="contact-form" class="flex-grow flex flex-col justify-between">
							<div class="space-y-5">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
									<!-- Name -->
									<div>
										<label for="contact-name" class="flex items-center space-x-1.5 text-xs font-mono font-bold text-neutral-300 uppercase mb-2">
											<svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
											</svg>
											<span>Your Name</span>
											<span class="text-sky-400">*</span>
										</label>
										<input 
											type="text" 
											id="contact-name" 
											name="name"
											required
											placeholder="Jane Doe" 
											class="w-full px-4 py-3 rounded-xl bg-[#030407] border border-white/15 text-white text-xs placeholder-neutral-500 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all"
										/>
									</div>

									<!-- Email -->
									<div>
										<label for="contact-email" class="flex items-center space-x-1.5 text-xs font-mono font-bold text-neutral-300 uppercase mb-2">
											<svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
											</svg>
											<span>Email Address</span>
											<span class="text-sky-400">*</span>
										</label>
										<input 
											type="email" 
											id="contact-email" 
											name="email"
											required
											placeholder="jane@example.com" 
											class="w-full px-4 py-3 rounded-xl bg-[#030407] border border-white/15 text-white text-xs placeholder-neutral-500 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all"
										/>
									</div>
								</div>

								<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
									<!-- Topic Category (Custom Glassmorphic Dropdown) -->
									<div class="relative" id="custom-category-dropdown">
										<label class="flex items-center space-x-1.5 text-xs font-mono font-bold text-neutral-300 uppercase mb-2">
											<svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
											</svg>
											<span>Inquiry Category</span>
											<span class="text-sky-400">*</span>
										</label>
										
										<!-- Hidden form value for standard form submittal -->
										<input type="hidden" id="contact-category" name="category" value="general" />

										<!-- Dropdown Trigger Button -->
										<button 
											type="button"
											id="category-dropdown-btn"
											aria-aria-expanded="false"
											aria-aria-haspopup="listbox"
											class="w-full px-4 py-3 rounded-xl bg-[#030407] border border-white/15 text-white text-xs flex items-center justify-between text-left focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all hover:bg-white/[0.02]"
										>
											<span class="flex items-center space-x-2.5 overflow-hidden">
												<span id="selected-category-dot" class="w-2 h-2 rounded-full bg-sky-400 shrink-0"></span>
												<span id="selected-category-text" class="truncate font-medium">General Inquiry</span>
											</span>
											<svg id="category-dropdown-chevron" class="w-4 h-4 text-neutral-400 transition-transform duration-200 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
											</svg>
										</button>

										<!-- Floating Options Menu -->
										<div 
											id="category-dropdown-menu" 
											class="hidden absolute z-50 top-full left-0 right-0 mt-2 p-1.5 rounded-xl bg-[#0a0c10]/98 backdrop-blur-xl border border-white/15 shadow-2xl space-y-1 max-h-60 overflow-y-auto"
											role="listbox"
										>
											<button
												type="button"
												data-value="general"
												data-color="bg-sky-400"
												class="category-option w-full px-3 py-2.5 rounded-lg text-xs flex items-center justify-between transition-colors bg-white/10 text-white font-medium group"
											>
												<span class="flex items-center space-x-2.5 truncate">
													<span class="w-2 h-2 rounded-full bg-sky-400 shrink-0"></span>
													<span class="truncate">General Inquiry</span>
												</span>
												<svg class="option-checkmark w-4 h-4 text-sky-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
												</svg>
											</button>

											<button
												type="button"
												data-value="technical"
												data-color="bg-indigo-400"
												class="category-option w-full px-3 py-2.5 rounded-lg text-xs flex items-center justify-between transition-colors text-neutral-300 hover:bg-white/5 hover:text-white font-medium group"
											>
												<span class="flex items-center space-x-2.5 truncate">
													<span class="w-2 h-2 rounded-full bg-indigo-400 shrink-0"></span>
													<span class="truncate">Technical Support / Bug Report</span>
												</span>
												<svg class="option-checkmark w-4 h-4 text-indigo-400 shrink-0 ml-2 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
												</svg>
											</button>

											<button
												type="button"
												data-value="caregiver"
												data-color="bg-emerald-400"
												class="category-option w-full px-3 py-2.5 rounded-lg text-xs flex items-center justify-between transition-colors text-neutral-300 hover:bg-white/5 hover:text-white font-medium group"
											>
												<span class="flex items-center space-x-2.5 truncate">
													<span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>
													<span class="truncate">Caregiver Cloud / Server Node</span>
												</span>
												<svg class="option-checkmark w-4 h-4 text-emerald-400 shrink-0 ml-2 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
												</svg>
											</button>

											<button
												type="button"
												data-value="security"
												data-color="bg-purple-400"
												class="category-option w-full px-3 py-2.5 rounded-lg text-xs flex items-center justify-between transition-colors text-neutral-300 hover:bg-white/5 hover:text-white font-medium group"
											>
												<span class="flex items-center space-x-2.5 truncate">
													<span class="w-2 h-2 rounded-full bg-purple-400 shrink-0"></span>
													<span class="truncate">Security & Vulnerability Disclosure</span>
												</span>
												<svg class="option-checkmark w-4 h-4 text-purple-400 shrink-0 ml-2 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
												</svg>
											</button>

											<button
												type="button"
												data-value="feedback"
												data-color="bg-amber-400"
												class="category-option w-full px-3 py-2.5 rounded-lg text-xs flex items-center justify-between transition-colors text-neutral-300 hover:bg-white/5 hover:text-white font-medium group"
											>
												<span class="flex items-center space-x-2.5 truncate">
													<span class="w-2 h-2 rounded-full bg-amber-400 shrink-0"></span>
													<span class="truncate">Feature Proposal & Feedback</span>
												</span>
												<svg class="option-checkmark w-4 h-4 text-amber-400 shrink-0 ml-2 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
												</svg>
											</button>
										</div>
									</div>

									<!-- Subject -->
									<div>
										<label for="contact-subject" class="flex items-center space-x-1.5 text-xs font-mono font-bold text-neutral-300 uppercase mb-2">
											<svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
											</svg>
											<span>Subject</span>
											<span class="text-sky-400">*</span>
										</label>
										<input 
											type="text" 
											id="contact-subject" 
											name="subject"
											required
											placeholder="How to connect self-hosted node..." 
											class="w-full px-4 py-3 rounded-xl bg-[#030407] border border-white/15 text-white text-xs placeholder-neutral-500 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all"
										/>
									</div>
								</div>

								<!-- Message -->
								<div>
									<label for="contact-message" class="flex items-center space-x-1.5 text-xs font-mono font-bold text-neutral-300 uppercase mb-2">
										<svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
										</svg>
										<span>Message</span>
										<span class="text-sky-400">*</span>
									</label>
									<textarea 
										id="contact-message" 
										name="message"
										rows="4"
										required
										placeholder="Please describe your question or issue in detail..." 
										class="w-full px-4 py-3 rounded-xl bg-[#030407] border border-white/15 text-white text-xs placeholder-neutral-500 focus:outline-none focus:border-sky-400 focus:ring-1 focus:ring-sky-400/30 transition-all resize-y"
									></textarea>
								</div>
							</div>

							<!-- Sticky Bottom Submit Section & Persistent Cooldown Notice -->
							<div class="pt-4 mt-auto">
								<!-- Persistent Anti-Bot Cooldown Warning Banner -->
								<div id="cooldown-banner" class="hidden mb-3 text-center text-[11px] font-mono text-amber-300 bg-amber-500/10 border border-amber-500/30 py-2.5 px-4 rounded-xl flex items-center justify-center space-x-2">
									<svg class="w-4 h-4 text-amber-400 shrink-0 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
									<span>Anti-bot cooldown active: Please wait <strong id="cooldown-timer-text" class="text-amber-200">60s</strong> before sending another message.</span>
								</div>

								<button 
									type="submit" 
									id="submit-btn"
									class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-sky-500 to-blue-600 text-white font-bold text-xs uppercase tracking-wider hover:from-sky-400 hover:to-blue-500 transition-all shadow-lg hover:shadow-sky-500/25 flex items-center justify-center space-x-2 group disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-none"
								>
									<span id="submit-btn-text">Send Message</span>
									<svg id="submit-btn-icon" class="w-4 h-4 text-white group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
									</svg>
								</button>

								<!-- Success Confirmation Box -->
								<div id="form-success" class="hidden mt-3 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center space-x-3">
									<svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									<span>Thank you! Your message has been received. A Dosezy team member will reach out shortly.</span>
								</div>
							</div>
						</form>
					</div>
				</div>

				<!-- Column 2: Recommended Email Option Card (5 Cols) -->
				<div class="lg:col-span-5">
					<div class="vercel-card p-6 sm:p-8 rounded-3xl border border-sky-500/30 bg-[#0c1017]/95 shadow-2xl relative overflow-hidden flex flex-col justify-between h-full">
						<!-- Glow background accent -->
						<div class="absolute -top-10 -right-10 w-40 h-40 bg-sky-500/10 blur-[50px] rounded-full pointer-events-none"></div>

						<div class="space-y-6">
							<!-- Recommended Tag -->
							<div class="flex items-center justify-between">
								<span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 inline-flex items-center space-x-1.5 shadow-sm">
									<svg class="w-3.5 h-3.5 text-amber-400 fill-current" viewBox="0 0 24 24" aria-hidden="true">
