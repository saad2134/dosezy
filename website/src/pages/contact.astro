<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const successMsg = document.getElementById('form-success');
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
	const submitBtnText = document.getElementById('submit-btn-text');
	const submitBtnIcon = document.getElementById('submit-btn-icon');
	const cooldownBanner = document.getElementById('cooldown-banner');
	const cooldownTimerText = document.getElementById('cooldown-timer-text');

	// Custom Dropdown elements
	const dropdownContainer = document.getElementById('custom-category-dropdown');
	const dropdownBtn = document.getElementById('category-dropdown-btn');
	const dropdownMenu = document.getElementById('category-dropdown-menu');
	const dropdownChevron = document.getElementById('category-dropdown-chevron');
	const hiddenInput = document.getElementById('contact-category') as HTMLInputElement | null;
	const selectedText = document.getElementById('selected-category-text');
	const selectedDot = document.getElementById('selected-category-dot');
	const options = document.querySelectorAll('.category-option');

	if (dropdownBtn && dropdownMenu && dropdownChevron) {
		const toggleMenu = (open?: boolean) => {
			const isExpanded = open !== undefined ? open : dropdownMenu.classList.contains('hidden');
			if (isExpanded) {
				dropdownMenu.classList.remove('hidden');
				dropdownChevron.classList.add('rotate-180');
				dropdownBtn.setAttribute('aria-expanded', 'true');
				dropdownBtn.classList.add('border-sky-400', 'ring-1', 'ring-sky-400/30');
			} else {
				dropdownMenu.classList.add('hidden');
				dropdownChevron.classList.remove('rotate-180');
				dropdownBtn.setAttribute('aria-expanded', 'false');
				dropdownBtn.classList.remove('border-sky-400', 'ring-1', 'ring-sky-400/30');
			}
		};

		dropdownBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			toggleMenu();
		});

		options.forEach(opt => {
			opt.addEventListener('click', (e) => {
				e.stopPropagation();
				const target = opt as HTMLButtonElement;
				const val = target.dataset.value || '';
				const colorClass = target.dataset.color || 'bg-sky-400';
				const labelText = target.querySelector('.truncate')?.textContent || '';

				if (hiddenInput) hiddenInput.value = val;
				if (selectedText) selectedText.textContent = labelText;
				if (selectedDot) {
					selectedDot.className = `w-2 h-2 rounded-full ${colorClass} shrink-0`;
				}

				// Update active option styling & checkmarks
				options.forEach(o => {
					const btn = o as HTMLButtonElement;
					const checkmark = btn.querySelector('.option-checkmark');
					if (btn === target) {
						btn.classList.add('bg-white/10', 'text-white');
						btn.classList.remove('text-neutral-300', 'hover:bg-white/5');
						if (checkmark) checkmark.classList.remove('hidden');
					} else {
						btn.classList.remove('bg-white/10', 'text-white');
						btn.classList.add('text-neutral-300', 'hover:bg-white/5');
						if (checkmark) checkmark.classList.add('hidden');
					}
				});

				toggleMenu(false);
			});
		});

		// Close dropdown on click outside
		document.addEventListener('click', (e) => {
			if (dropdownContainer && !dropdownContainer.contains(e.target as Node)) {
				toggleMenu(false);
			}
		});

		// Close dropdown on Escape key
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				toggleMenu(false);
			}
		});
	}

	// Client-Based 60-Second Persistent Cooldown Logic
	const COOLDOWN_KEY = 'dosezy_contact_last_submit';
	const COOLDOWN_TIME_SECONDS = 60;
	let cooldownTimerInterval: ReturnType<typeof setInterval> | null = null;

	const startCooldownTimer = (secondsRemaining: number) => {
		if (!submitBtn || !submitBtnText || !cooldownBanner || !cooldownTimerText) return;

		// Lock submit button
		submitBtn.disabled = true;
		if (submitBtnIcon) submitBtnIcon.classList.add('hidden');

		const updateUI = (remSecs: number) => {
			if (remSecs <= 0) {
				if (cooldownTimerInterval) clearInterval(cooldownTimerInterval);
				cooldownTimerInterval = null;
				submitBtn.disabled = false;
				submitBtnText.textContent = 'Send Message';
				if (submitBtnIcon) submitBtnIcon.classList.remove('hidden');
				cooldownBanner.classList.add('hidden');
				return;
			}

			submitBtnText.textContent = `Cooldown Active (${remSecs}s)`;
			cooldownTimerText.textContent = `${remSecs}s`;
			cooldownBanner.classList.remove('hidden');
		};

		updateUI(secondsRemaining);

		if (cooldownTimerInterval) clearInterval(cooldownTimerInterval);

		cooldownTimerInterval = setInterval(() => {
			const lastSubmit = localStorage.getItem(COOLDOWN_KEY);
			if (!lastSubmit) {
				updateUI(0);
				return;
			}

			const elapsed = Math.floor((Date.now() - parseInt(lastSubmit, 10)) / 1000);
			const remaining = COOLDOWN_TIME_SECONDS - elapsed;
			updateUI(remaining);
		}, 1000);
	};

	const checkAndInitCooldown = () => {
		const lastSubmit = localStorage.getItem(COOLDOWN_KEY);
		if (lastSubmit) {
			const elapsed = Math.floor((Date.now() - parseInt(lastSubmit, 10)) / 1000);
			const remaining = COOLDOWN_TIME_SECONDS - elapsed;
			if (remaining > 0) {
				startCooldownTimer(remaining);
				return true;
			}
		}
		return false;
	};

	// Check on page load / reload
	checkAndInitCooldown();

	if (form && successMsg && submitBtn) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();

			// Double check cooldown enforcement
			if (checkAndInitCooldown()) {
				return;
			}
			
			// Show loading state
			submitBtn.disabled = true;
			if (submitBtnText) submitBtnText.textContent = 'Sending Message...';
			submitBtn.classList.add('opacity-75');

			setTimeout(() => {
				form.reset();
				submitBtn.classList.remove('opacity-75');
				if (successMsg) successMsg.classList.remove('hidden');

				// Record timestamp in localStorage for persistent client-side rate limiting
				localStorage.setItem(COOLDOWN_KEY, Date.now().toString());

				// Reset custom dropdown display
				if (hiddenInput) hiddenInput.value = 'general';
				if (selectedText) selectedText.textContent = 'General Inquiry';
				if (selectedDot) selectedDot.className = 'w-2 h-2 rounded-full bg-sky-400 shrink-0';

				// Start 60-second cooldown timer
				startCooldownTimer(COOLDOWN_TIME_SECONDS);

				setTimeout(() => {
					if (successMsg) successMsg.classList.add('hidden');
				}, 6000);
			}, 800);
		});
	}
</script>
