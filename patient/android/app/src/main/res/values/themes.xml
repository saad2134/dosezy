<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Dosezy" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">#F8F9FA</item>
    </style>

    <style name="Theme.Dosezy" parent="Base.Theme.Dosezy">
        <item name="android:windowBackground">#F8F9FA</item>
    </style>

    <!-- Simple splash screen theme - compatible with all Android versions -->
    <style name="Theme.AppStarting" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>