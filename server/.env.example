# ==============================================================================
# Dosezy Backend Server Environment Configuration
# ==============================================================================

# Server network binding
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
# - SQLite (Default zero-config): file:./dosezy.db
# - PostgreSQL (Production): postgres://dosezy:securepass@localhost:5432/dosezy_db
DATABASE_URL=file:./dosezy.db

# Cryptography & Security
# 32-byte secret used for End-to-End Encryption payload verification
E2EE_ENCRYPTION_SECRET=dosezy_dev_e2ee_secret_key_32_bytes_len!
JWT_SECRET=dosezy_jwt_auth_secret_key_2026_secure

# Allowed CORS Origins (comma separated, or leave blank to allow all in dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
